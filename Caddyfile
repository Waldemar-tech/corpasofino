{
	# Deshabilitar TLS: Railway maneja HTTPS en el proxy
	auto_https off
}

# Escuchar en el puerto inyectado por Railway (default 8080)
:{$PORT:8080}

root * /srv

# Comprime todo
encode zstd gzip

# Cabeceras de seguridad
header {
	X-Content-Type-Options "nosniff"
	Referrer-Policy "strict-origin-when-cross-origin"
	X-Frame-Options "SAMEORIGIN"
	Strict-Transport-Security "max-age=31536000; includeSubDomains"
	Permissions-Policy "geolocation=(), microphone=(), camera=()"
	-Server
}

# Assets de /_astro/ (con hash)
@astro path /_astro/*
handle @astro {
	header Cache-Control "public, max-age=31536000, immutable"
	file_server
}

# Assets estáticos
@static path *.png *.jpg *.jpeg *.webp *.avif *.svg *.woff2 *.woff *.ico
handle @static {
	header Cache-Control "public, max-age=2592000"
	file_server
}

# HTML con revalidación
handle {
	header Cache-Control "public, max-age=0, must-revalidate"
	try_files {path} {path}.html {path}/index.html
	file_server
}

# 404
handle_errors {
	@notfound expression {err.status_code} == 404
	handle @notfound {
		rewrite * /404.html
		file_server
	}
}
