# Railway define PORT en tiempo de ejecución. En local, 8080.
0.0.0.0:{$PORT:8080}

root * /srv

# Comprime todo lo que se pueda. Con conexiones móviles lentas esto
# se nota más que cualquier micro-optimización del código.
encode zstd gzip

# Cabeceras de seguridad: aplican a todas las respuestas.
header {
	X-Content-Type-Options "nosniff"
	Referrer-Policy "strict-origin-when-cross-origin"
	X-Frame-Options "SAMEORIGIN"
	Strict-Transport-Security "max-age=31536000; includeSubDomains"
	Permissions-Policy "geolocation=(), microphone=(), camera=()"
	-Server
}

# Archivos servidos desde /public (favicons, imágenes OG, manifest).
@estaticos path *.png *.jpg *.jpeg *.webp *.avif *.svg *.woff2 *.woff *.ico

# ── Caché ───────────────────────────────────────────────────────
# Se usan bloques handle y no varias directivas header porque los
# handle son mutuamente excluyentes: entra al primero que coincide
# y ya. Con directivas header sueltas, Caddy las anida y el orden
# efectivo no es el que uno escribe — resultado: todo terminaba con
# la misma cabecera de caché.

# Los archivos de /_astro/ llevan hash en el nombre: si cambia el
# contenido, cambia la URL. Se cachean para siempre sin riesgo.
handle /_astro/* {
	header Cache-Control "public, max-age=31536000, immutable"
	file_server
}

# Íconos, imágenes OG y fuentes sueltas de /public: un mes.
handle @estaticos {
	header Cache-Control "public, max-age=2592000"
	file_server
}

# Todo lo demás es HTML (y robots/sitemap): se revalida siempre, para
# que un cambio de texto o de precio se vea de inmediato.
handle {
	header Cache-Control "public, max-age=0, must-revalidate"

	# El build de Astro genera /productos/ketchup.html; esto lo sirve
	# en /productos/ketchup sin redirección de por medio.
	try_files {path} {path}.html {path}/index.html
	file_server
}

# ── Página 404 propia ───────────────────────────────────────────
handle_errors {
	@notfound expression {err.status_code} == 404
	handle @notfound {
		rewrite * /404.html
		file_server
	}
}
