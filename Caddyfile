# Railway define PORT en tiempo de ejecución. En local, 8080.
:{$PORT:8080}

root * /srv

# Comprime todo lo que se pueda. Con conexiones móviles lentas esto
# se nota más que cualquier micro-optimización del código.
encode zstd gzip

# Cabeceras de seguridad: aplican a todas las respuestas.
header {
	X-Content-Type-Options "nosniff"
	Referrer-Policy "strict-origin-when-cross-origin"
	X-Frame-Options "SAMEORIGIN"
	Strict-Transport-Security "max-age=31536000; includeSubDomains"
	Permissions-Policy "geolocation=(), microphone=(), camera=()"
	-Server
}

# Archivos servidos desde /public (favicons, imágenes OG, manifest).
@estaticos path *.png *.jpg *.jpeg *.webp *.avif *.svg *.woff2 *.woff *.ico

# ── Caché ───────────────────────────────────────────────────────
# Se usan bloques handle y no varias directivas header porque los
# handle son mutuamente excluyentes: entra al primero que coincide
# y ya. Con directivas header sueltas, Caddy las anida y el orden
# efectivo no es el que uno escribe — resultado: todo terminaba con
# la misma cabecera de caché.

# ── Redirecciones de la estructura vieja ───────────────────────
# Antes el sitio era sólo de Foodie y el catálogo vivía en /productos
# y /recetas. Al pasar a casa de marcas (Paso Fino en la raíz, cada
# línea en su carpeta), esas rutas se mudaron bajo /foodie.
#
# Van con 301 (permanent) y no con 302: le dice a Google que la mudanza
# es definitiva y le traspasa a la URL nueva la autoridad que la vieja
# hubiera acumulado. Con 302 se quedaría indexando la vieja.
#
# Esto va ARRIBA de todo: si quedara debajo del file_server, Caddy
# serviría un 404 antes de llegar a redirigir.
handle /productos* {
	# El `*` es obligatorio aquí: la sintaxis es
	# `redir [<matcher>] <destino> [<código>]`, y Caddy toma como
	# matcher cualquier primer token que empiece por «/». Sin el `*`,
	# lee «/foodie{uri}» como filtro de ruta en vez de como destino,
	# y devuelve un 200 vacío en lugar de redirigir.
	redir * /foodie{uri} permanent
}

handle /recetas* {
	# El `*` es obligatorio aquí: la sintaxis es
	# `redir [<matcher>] <destino> [<código>]`, y Caddy toma como
	# matcher cualquier primer token que empiece por «/». Sin el `*`,
	# lee «/foodie{uri}» como filtro de ruta en vez de como destino,
	# y devuelve un 200 vacío en lugar de redirigir.
	redir * /foodie{uri} permanent
}

# El catálogo de Los Lirios se publicó primero con cinco productos
# hipotéticos, puestos para poder maquetar. Al llegar la línea real
# (etiquetas de la diseñadora incluidas) cambiaron los nombres, y con
# ellos las URLs. Las viejas alcanzaron a estar en el sitemap, así que
# se redirigen en vez de dejarlas caer en 404:
#   mayonesa        → preparado-mayonesa
#   mostaza         → salsa-a-base-de-mostaza
#   salsa-de-tomate → salsa-a-base-de-tomate
# «salsa-de-ajo» y «salsa-rosada» no tienen equivalente —esos productos
# no existen en la línea— así que van al catálogo, que es la respuesta
# honesta: el producto no está, aquí está lo que sí hay.
redir /los-lirios/productos/mayonesa /los-lirios/productos/preparado-mayonesa permanent
redir /los-lirios/productos/mostaza /los-lirios/productos/salsa-a-base-de-mostaza permanent
redir /los-lirios/productos/salsa-de-tomate /los-lirios/productos/salsa-a-base-de-tomate permanent
redir /los-lirios/productos/salsa-de-ajo /los-lirios/productos permanent
redir /los-lirios/productos/salsa-rosada /los-lirios/productos permanent

# Los archivos de /_astro/ llevan hash en el nombre: si cambia el
# contenido, cambia la URL. Se cachean para siempre sin riesgo.
handle /_astro/* {
	header Cache-Control "public, max-age=31536000, immutable"
	file_server
}

# Íconos, imágenes OG y fuentes sueltas de /public: un mes.
handle @estaticos {
	header Cache-Control "public, max-age=2592000"
	file_server
}

# Todo lo demás es HTML (y robots/sitemap): se revalida siempre, para
# que un cambio de texto o de precio se vea de inmediato.
handle {
	header Cache-Control "public, max-age=0, must-revalidate"

	# El build de Astro genera /productos/ketchup.html; esto lo sirve
	# en /productos/ketchup sin redirección de por medio.
	try_files {path} {path}.html {path}/index.html
	file_server
}

# ── Página 404 propia ───────────────────────────────────────────
handle_errors {
	@notfound expression {err.status_code} == 404
	handle @notfound {
		rewrite * /404.html
		file_server
	}
}
