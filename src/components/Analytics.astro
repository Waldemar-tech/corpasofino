---
/**
 * Etiquetas de publicidad — va dentro del <head>.
 *
 * Estrategia doble acordada:
 *   1. Meta Pixel cargado directo. Si GTM falla o lo bloquea una
 *      extensión, el píxel igual reporta. Es el que paga las campañas.
 *   2. GTM como contenedor para todo lo demás (GA4, Google Ads,
 *      TikTok Pixel). Así se agregan etiquetas nuevas sin redeploy.
 *
 * Mientras los IDs estén en null no se inyecta nada: el sitio no
 * arrastra scripts vacíos ni ensucia los datos durante el desarrollo.
 *
 * Nota técnica: los scripts se arman como cadenas aquí arriba y no
 * en línea en el markup, porque las llaves de JavaScript dentro de
 * una plantilla en el template confunden al compilador de Astro.
 */
import { TRACKING } from '../config/site.js';

const { metaPixelId, gtmId, ga4Id } = TRACKING;

const scriptGtm = gtmId
  ? [
      "(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':",
      "new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],",
      "j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=",
      "'https://www.googletagmanager.com/gtm.js?id='+i+dl;",
      'f.parentNode.insertBefore(j,f);',
      "})(window,document,'script','dataLayer','" + gtmId + "');",
    ].join('\n')
  : '';

const scriptPixel = metaPixelId
  ? [
      '!function(f,b,e,v,n,t,s)',
      '{if(f.fbq)return;n=f.fbq=function(){n.callMethod?',
      'n.callMethod.apply(n,arguments):n.queue.push(arguments)};',
      "if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';",
      'n.queue=[];t=b.createElement(e);t.async=!0;',
      't.src=v;s=b.getElementsByTagName(e)[0];',
      "s.parentNode.insertBefore(t,s)}(window,document,'script',",
      "'https://connect.facebook.net/en_US/fbevents.js');",
      "fbq('init','" + metaPixelId + "');",
      "fbq('track','PageView');",
    ].join('\n')
  : '';

const noscriptPixel = metaPixelId
  ? '<img height="1" width="1" style="display:none" alt="" src="https://www.facebook.com/tr?id=' +
    metaPixelId +
    '&ev=PageView&noscript=1"/>'
  : '';

const usarGtagDirecto = Boolean(ga4Id) && !gtmId;
const scriptGtag = usarGtagDirecto
  ? [
      'window.dataLayer=window.dataLayer||[];',
      'function gtag(){dataLayer.push(arguments);}',
      "gtag('js',new Date());",
      "gtag('config','" + ga4Id + "');",
    ].join('\n')
  : '';

const srcGtag = usarGtagDirecto
  ? 'https://www.googletagmanager.com/gtag/js?id=' + ga4Id
  : '';
---

{gtmId && <script is:inline set:html={scriptGtm} />}

{metaPixelId && <script is:inline set:html={scriptPixel} />}
{metaPixelId && <noscript is:inline set:html={noscriptPixel} />}

{usarGtagDirecto && <script is:inline async src={srcGtag} />}
{usarGtagDirecto && <script is:inline set:html={scriptGtag} />}
