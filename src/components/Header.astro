---
import { Image } from 'astro:assets';
import Icono from './Icono.astro';
import logoPasoFino from '../assets/brand/logo-pasofino.png';
import logoLirios from '../assets/brand/logo-los-lirios-rojo.png';
import { NAV, REDES, SITE } from '../config/site.js';
import { getMarca, navMarca, listaMarcas } from '../config/marcas.js';
import { enlaceWhatsApp } from '../lib/whatsapp.js';

interface Props {
  /** Slug de la marca en la que estamos, o null en páginas corporativas. */
  marca?: string | null;
}

const { marca = null } = Astro.props;
const m = marca ? getMarca(marca) : null;

// Los Lirios tiene logotipo propio y lo usa en su cabecera. Foodie no
// tiene uno para el header, así que ahí va el corporativo en blanco
// acompañado del nombre de la línea.
const usaLogoPropio = m?.header?.logo === 'los-lirios';
const logo = usaLogoPropio ? logoLirios : logoPasoFino;

// En la raíz manda Paso Fino y las marcas son el menú. Dentro de una
// marca, el menú es el de esa marca y aparece el camino de vuelta a
// la corporación. El logo es siempre el de Paso Fino: es el único que
// existe, y en una casa de marcas es además lo correcto.
const enlaces = m ? navMarca(marca!) : NAV;

// En el menú móvil la barra corporativa queda arriba del todo y hay
// que desplegar el menú para ver sus enlaces, así que la otra línea y
// la vuelta a la casa se repiten aquí dentro. En escritorio no: ahí la
// barra está siempre a la vista.
const otraMarca = m ? listaMarcas().find((x) => x.slug !== marca) : null;

const ruta = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const activo = (href: string) =>
  href === '/' ? ruta === '/' : ruta === href || ruta.startsWith(href + '/');

const wa = enlaceWhatsApp('general');
const tieneIg = !REDES.instagram.includes('REEMPLAZAR');
---

<header class="cabecera" data-marca={marca ?? 'corporativo'}>
  <div class="cabecera__interior">
    <a
      href={m ? `/${m.slug}` : '/'}
      class="cabecera__logo"
      aria-label={m ? `${m.nombre} — inicio` : `${SITE.nombreLegal} — inicio`}
    >
      {
        usaLogoPropio || !m ? (
          <Image
            src={logo}
            alt={usaLogoPropio ? m.nombre : SITE.nombreLegal}
            widths={[220, 440]}
            sizes="180px"
            loading="eager"
          />
        ) : (
          /* Foodie no tiene logotipo para cabecera —el óvalo verde no
             se lee sobre fondo verde— así que va su nombre como
             rótulo, en la tipografía de la marca. Antes iba el
             logotipo de Paso Fino, pero desde que existe la barra
             corporativa arriba salía dos veces en la misma pantalla. */
          <span class="cabecera__rotulo">{m.nombre}</span>
        )
      }
    </a>

    <nav class="cabecera__nav" aria-label="Navegación principal">
      <ul>
        {
          enlaces.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['cabecera__enlace', { activo: activo(item.href) }]}
                aria-current={activo(item.href) ? 'page' : undefined}
              >
                {item.texto}
              </a>
            </li>
          ))
        }
        {/* El enlace de vuelta a Paso Fino vivía aquí, apagado y de
            último en el menú. Ahora vive en la barra corporativa de
            arriba, junto al logotipo de la casa; repetirlo sería
            ruido y dos caminos para lo mismo. */}
      </ul>
    </nav>

    <div class="cabecera__acciones">
      <a href="/#distribuidores" class="cabecera__distribuidores">
        ¿Eres distribuidor?
      </a>

      <div class="cabecera__redes">
        {
          tieneIg && (
            <a
              href={REDES.instagram}
              class="cabecera__red"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram"
            >
              <Icono nombre="instagram" tamano={20} />
            </a>
          )
        }
        <a
          href={wa}
          class="cabecera__red"
          data-wa="general"
          data-wa-etiqueta={m ? `Header ${m.nombre}` : 'Header corporativo'}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Escríbenos por WhatsApp"
        >
          <Icono nombre="whatsapp" tamano={20} />
        </a>
      </div>

      <button
        class="cabecera__hamburguesa"
        type="button"
        aria-expanded="false"
        aria-controls="menu-movil"
        aria-label="Abrir menú"
      >
        <Icono nombre="menu" tamano={26} />
      </button>
    </div>
  </div>

  <!-- Menú móvil -->
  <div class="movil" id="menu-movil" hidden>
    <nav aria-label="Navegación móvil">
      <ul>
        {
          enlaces.map((item) => (
            <li>
              <a href={item.href}>{item.texto}</a>
            </li>
          ))
        }
        {m && <li><a href={`/${otraMarca.slug}`}>{otraMarca.nombre}</a></li>}
        {m && <li><a href="/">Paso Fino</a></li>}
        {!m && <li><a href="/contacto">Contacto</a></li>}
      </ul>
    </nav>
    <a href="/#distribuidores" class="btn btn--blanco movil__cta">
      ¿Eres distribuidor?
    </a>
    <div class="movil__redes">
      {
        tieneIg && (
          <a href={REDES.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            <Icono nombre="instagram" tamano={24} />
          </a>
        )
      }
      <a
        href={wa}
        data-wa="general"
        data-wa-etiqueta="Menú móvil"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="WhatsApp"
      >
        <Icono nombre="whatsapp" tamano={24} />
      </a>
    </div>
  </div>
</header>

<style>
  /* Fondo y color de texto los pone la marca activa: Foodie va en
     verde con texto blanco, Los Lirios en crema con texto vino. */
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--marca-header-fondo);
    color: var(--marca-header-texto);
  }

  .cabecera__interior {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 3rem);
    width: 100%;
    max-width: var(--ancho);
    margin-inline: auto;
    padding: 0.75rem var(--margen);
    min-height: 84px;
  }

  .cabecera__logo {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .cabecera__logo :global(img) {
    width: clamp(112px, 11vw, 150px);
    height: auto;
  }

  /* Rótulo de la marca cuando no tiene logotipo propio. */
  .cabecera__rotulo {
    font-family: var(--marca-display);
    font-stretch: var(--marca-display-ancho);
    font-size: clamp(1.9rem, 1.4rem + 1.5vw, 2.9rem);
    line-height: 1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* Marca de la línea, al lado del logo corporativo. */
  .cabecera__submarca {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    font-family: var(--marca-display);
    font-stretch: var(--marca-display-ancho);
    font-size: clamp(1.05rem, 0.9rem + 0.5vw, 1.5rem);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .cabecera__submarca-sep {
    display: block;
    width: 1.5px;
    height: 2em;
    background: currentColor;
    opacity: 0.45;
  }

  .cabecera__nav {
    flex: 1;
  }

  .cabecera__nav ul {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 2.75rem);
  }

  .cabecera__enlace {
    position: relative;
    display: inline-block;
    padding-block: 0.35rem;
    font-family: var(--condensada);
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    transition: opacity var(--transicion);
  }

  .cabecera__enlace::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--transicion);
  }

  .cabecera__enlace:hover::after,
  .cabecera__enlace.activo::after {
    transform: scaleX(1);
  }

  .cabecera__enlace.activo {
    font-style: italic;
    font-weight: 700;
  }

  /* El camino de vuelta a la corporación: presente pero discreto. */
  .cabecera__volver {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 1.05rem;
    opacity: 0.75;
  }

  .cabecera__volver:hover {
    opacity: 1;
  }

  .cabecera__acciones {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 1.5vw, 1.5rem);
    margin-left: auto;
  }

  .cabecera__distribuidores {
    padding: 0.55rem 1.1rem;
    font-family: var(--condensada);
    font-size: 1.05rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--marca-pastilla-texto);
    background: var(--marca-pastilla-fondo);
    border-radius: var(--radio-pill);
    white-space: nowrap;
    transition:
      background var(--transicion),
      color var(--transicion);
  }

  .cabecera__distribuidores:hover {
    background: var(--marca-acento);
    color: var(--marca-oscuro);
  }

  .cabecera__redes {
    display: flex;
    gap: 0.6rem;
  }

  .cabecera__red {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1.5px solid currentColor;
    border-radius: 9px;
    opacity: 0.8;
    transition:
      background var(--transicion),
      border-color var(--transicion),
      color var(--transicion);
  }

  .cabecera__red:hover {
    opacity: 1;
    background: var(--marca-pastilla-fondo);
    border-color: var(--marca-pastilla-fondo);
    color: var(--marca-pastilla-texto);
  }

  .cabecera__hamburguesa {
    display: none;
    color: var(--blanco);
    padding: 0.25rem;
  }

  /* ── Menú móvil ─────────────────────────────────────────── */
  .movil {
    padding: 0 var(--margen) 2rem;
    border-top: 1px solid currentColor;
    border-color: color-mix(in srgb, currentColor 20%, transparent);
  }

  .movil[hidden] {
    display: none;
  }

  .movil ul {
    display: flex;
    flex-direction: column;
  }

  .movil a {
    display: block;
    padding: 1rem 0;
    font-family: var(--condensada);
    font-size: 1.5rem;
    font-weight: 600;
    text-transform: uppercase;
    border-bottom: 1px solid color-mix(in srgb, currentColor 18%, transparent);
  }

  .movil__cta {
    width: 100%;
    margin-top: 1.5rem;
  }

  .movil__redes {
    display: flex;
    gap: 1.25rem;
    margin-top: 1.75rem;
  }

  .movil__redes a {
    padding: 0;
    border: none;
  }

  @media (max-width: 1100px) {
    .cabecera__nav,
    .cabecera__distribuidores {
      display: none;
    }
    .cabecera__hamburguesa {
      display: block;
    }
    .cabecera__interior {
      min-height: 68px;
    }
  }

  @media (min-width: 1101px) {
    .movil {
      display: none !important;
    }
  }
</style>

<script>
  const boton = document.querySelector<HTMLButtonElement>('.cabecera__hamburguesa');
  const menu = document.getElementById('menu-movil');

  if (boton && menu) {
    boton.addEventListener('click', () => {
      const abierto = boton.getAttribute('aria-expanded') === 'true';
      boton.setAttribute('aria-expanded', String(!abierto));
      boton.setAttribute('aria-label', abierto ? 'Abrir menú' : 'Cerrar menú');
      menu.hidden = abierto;
    });

    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) {
        boton.setAttribute('aria-expanded', 'false');
        menu.hidden = true;
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        boton.setAttribute('aria-expanded', 'false');
        menu.hidden = true;
        boton.focus();
      }
    });
  }
</script>
