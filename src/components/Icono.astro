---
/**
 * Iconos en SVG en línea, redibujados a partir del diseño.
 *
 * Se usan SVG y no los PNG que vinieron en el Drive porque:
 *  · pesan ~200 bytes contra ~15 KB cada PNG,
 *  · se ven nítidos en cualquier densidad de pantalla,
 *  · heredan el color por CSS (currentColor), así el mismo icono
 *    sirve en blanco sobre el header verde y en verde sobre blanco.
 */

interface Props {
  nombre:
    | 'buscar'
    | 'usuario'
    | 'bolsa'
    | 'instagram'
    | 'tiktok'
    | 'whatsapp'
    | 'menu'
    | 'cerrar'
    | 'flecha'
    | 'casa'
    | 'mas'
    | 'menos'
    | 'chevron';
  tamano?: number | string;
  trazo?: number;
  clase?: string;
  titulo?: string;
}

const { nombre, tamano = 24, trazo = 2, clase = '', titulo } = Astro.props;
const attrs = {
  width: tamano,
  height: tamano,
  viewBox: '0 0 24 24',
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': trazo,
  'stroke-linecap': 'round',
  'stroke-linejoin': 'round',
  class: `icono ${clase}`,
  'aria-hidden': titulo ? undefined : 'true',
  role: titulo ? 'img' : undefined,
  focusable: 'false',
};
const rellenos = { ...attrs, fill: 'currentColor', stroke: 'none' };
---

{
  nombre === 'buscar' && (
    <svg {...attrs}>
      {titulo && <title>{titulo}</title>}
      <circle cx="11" cy="11" r="7" />
      <path d="m20 20-3.5-3.5" />
    </svg>
  )
}

{
  nombre === 'usuario' && (
    <svg {...attrs}>
      {titulo && <title>{titulo}</title>}
      <circle cx="12" cy="8" r="4" />
      <path d="M4 21a8 8 0 0 1 16 0" />
    </svg>
  )
}

{
  nombre === 'bolsa' && (
    <svg {...attrs}>
      {titulo && <title>{titulo}</title>}
      <path d="M4 8h16a1 1 0 0 1 1 1v9a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V9a1 1 0 0 1 1-1Z" />
      <path d="M8.5 8V6.5a3.5 3.5 0 0 1 7 0V8" />
    </svg>
  )
}

{
  nombre === 'casa' && (
    <svg {...attrs}>
      {titulo && <title>{titulo}</title>}
      <path d="M4 10.5 12 4l8 6.5" />
      <path d="M6 9.8V18a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V9.8" />
    </svg>
  )
}

{
  nombre === 'instagram' && (
    <svg {...attrs}>
      {titulo && <title>{titulo}</title>}
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none" />
    </svg>
  )
}

{
  nombre === 'tiktok' && (
    <svg {...rellenos}>
      {titulo && <title>{titulo}</title>}
      <path d="M20 8.6a6.6 6.6 0 0 1-4.1-1.4v6.6a5.6 5.6 0 1 1-4.8-5.5v2.9a2.8 2.8 0 1 0 2 2.6V2h2.8a4 4 0 0 0 4.1 3.8Z" />
    </svg>
  )
}

{
  nombre === 'whatsapp' && (
    <svg {...rellenos}>
      {titulo && <title>{titulo}</title>}
      <path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2Zm0 1.9a8.1 8.1 0 1 1-4.2 15l-.3-.2-3 .8.8-3-.2-.3A8.1 8.1 0 0 1 12 3.9Zm-3.6 4c-.2 0-.5.1-.7.4-.3.3-.9.9-.9 2.1s.9 2.4 1 2.6c.1.2 1.7 2.8 4.3 3.8 2.1.8 2.6.7 3 .6.6-.1 1.6-.7 1.9-1.4.2-.6.2-1.2.1-1.3l-.6-.3-1.6-.8c-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1-.2-.1-1-.4-2-1.2-.7-.7-1.2-1.5-1.4-1.7-.1-.2 0-.4.1-.5l.4-.5.3-.5v-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.6Z" />
    </svg>
  )
}

{
  nombre === 'menu' && (
    <svg {...attrs}>
      {titulo && <title>{titulo}</title>}
      <path d="M4 7h16M4 12h16M4 17h16" />
    </svg>
  )
}

{
  nombre === 'cerrar' && (
    <svg {...attrs}>
      {titulo && <title>{titulo}</title>}
      <path d="M6 6l12 12M18 6 6 18" />
    </svg>
  )
}

{
  nombre === 'flecha' && (
    <svg {...attrs}>
      {titulo && <title>{titulo}</title>}
      <path d="M5 12h14M13 6l6 6-6 6" />
    </svg>
  )
}

{
  nombre === 'chevron' && (
    <svg {...attrs}>
      {titulo && <title>{titulo}</title>}
      <path d="m9 5 7 7-7 7" />
    </svg>
  )
}

{
  nombre === 'mas' && (
    <svg {...attrs}>
      {titulo && <title>{titulo}</title>}
      <path d="M12 5v14M5 12h14" />
    </svg>
  )
}

{
  nombre === 'menos' && (
    <svg {...attrs}>
      {titulo && <title>{titulo}</title>}
      <path d="M5 12h14" />
    </svg>
  )
}

<style>
  .icono {
    flex-shrink: 0;
  }
</style>
