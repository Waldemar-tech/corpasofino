---
import { SITE, TRACKING } from '../config/site.js';

interface Props {
  titulo: string;
  descripcion: string;
  /** Ruta absoluta desde la raíz, ej. "/og/producto-ketchup.jpg" */
  imagen?: string;
  imagenAlt?: string;
  tipo?: 'website' | 'article' | 'product';
  /** Excluir de buscadores (páginas de gracias, pruebas) */
  noindex?: boolean;
  /** Uno o varios bloques JSON-LD ya construidos */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  titulo,
  descripcion,
  imagen = '/og/default.jpg',
  imagenAlt = 'Salsas y aderezos Foodie — Corporación Paso Fino, Barquisimeto',
  tipo = 'website',
  noindex = false,
  jsonLd,
} = Astro.props;

// Canonical: una sola URL por página, sin barra final, sin query
// params y sin la extensión .html.
//
// El .html hace falta explicarlo: como el build usa format:'file',
// Astro genera /recetas/x.html y el pathname en tiempo de render
// incluye esa extensión. Si no se limpia, la canonical apunta a
// .../x.html mientras el sitemap apunta a .../x — dos URLs para la
// misma página, que es justo la señal contradictoria que hace que
// Google reparta la autoridad entre ambas en vez de sumarla.
const limpio = Astro.url.pathname
  .replace(/\.html$/, '')
  .replace(/\/index$/, '')
  .replace(/\/$/, '');

const canonical = new URL(limpio || '/', SITE.url).href.replace(/\/$/, '');
const imagenAbsoluta = new URL(imagen, SITE.url).href;

// El título de marca va al final: en móvil Google corta por la derecha,
// así que lo importante debe ir primero.
const tituloCompleto = titulo.includes(SITE.marca)
  ? `${titulo} | ${SITE.nombreCorto}`
  : `${titulo} | ${SITE.marca} · ${SITE.nombreCorto}`;

const bloques = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{tituloCompleto}</title>
<meta name="description" content={descripcion} />
<link rel="canonical" href={canonical} />

{noindex && <meta name="robots" content="noindex, nofollow" />}
{
  !noindex && (
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
  )
}

<meta name="author" content={SITE.nombreLegal} />
<meta name="theme-color" content="#138B47" />

{/* Geolocalización: refuerza el SEO local para "salsas Barquisimeto". */}
<meta name="geo.region" content="VE-L" />
<meta name="geo.placename" content={SITE.ciudad} />
<meta name="geo.position" content={`${SITE.geo.lat};${SITE.geo.lng}`} />
<meta name="ICBM" content={`${SITE.geo.lat}, ${SITE.geo.lng}`} />

{/* Open Graph — esto es lo que se ve al pegar el link en WhatsApp,
    que en Venezuela es donde más se comparte. */}
<meta property="og:type" content={tipo === 'product' ? 'website' : tipo} />
<meta property="og:site_name" content={`${SITE.marca} · ${SITE.nombreCorto}`} />
<meta property="og:locale" content="es_VE" />
<meta property="og:title" content={tituloCompleto} />
<meta property="og:description" content={descripcion} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imagenAbsoluta} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imagenAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={tituloCompleto} />
<meta name="twitter:description" content={descripcion} />
<meta name="twitter:image" content={imagenAbsoluta} />
<meta name="twitter:image:alt" content={imagenAlt} />

<link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
<link rel="icon" href="/icon-192.png" sizes="192x192" type="image/png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="sitemap" href="/sitemap-index.xml" />

{/* Precarga la conexión a Meta sólo si el píxel está activo: ahorra
    unos 100 ms del handshake TLS cuando sí hay campañas corriendo. */}
{
  TRACKING.metaPixelId && (
    <link rel="preconnect" href="https://connect.facebook.net" crossorigin />
  )
}

{
  bloques.map((bloque) => (
    <script
      type="application/ld+json"
      set:html={JSON.stringify(bloque)}
      is:inline
    />
  ))
}
