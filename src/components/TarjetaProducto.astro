---
import { Image } from 'astro:assets';
import botella from '../assets/placeholder/botella.png';
import type { CollectionEntry } from 'astro:content';

interface Props {
  producto: CollectionEntry<'productos'>;
  /** Prioriza la carga de las primeras tarjetas visibles. */
  prioridad?: boolean;
}

const { producto, prioridad = false } = Astro.props;
const { data } = producto;
// El id de la colección viene como "foodie/ketchup"; la URL se arma
// con la marca declarada en el frontmatter y el nombre del archivo.
const slug = producto.id.split('/').pop();
const href = `/${data.marca}/productos/${slug}`;
const imagen = data.imagen ?? botella;
const esPlaceholder = !data.imagen;
---

<article class="tarjeta">
  <a href={href} class="tarjeta__enlace">
    <div class:list={['tarjeta__medio', { 'es-placeholder': esPlaceholder }]}>
      <Image
        src={imagen}
        alt={data.imagenAlt ?? `${data.nombre} Foodie`}
        widths={[240, 420, 640]}
        sizes="(max-width: 640px) 45vw, (max-width: 1024px) 30vw, 22vw"
        loading={prioridad ? 'eager' : 'lazy'}
        class="tarjeta__img"
      />
      {esPlaceholder && <span class="tarjeta__aviso">Foto pendiente</span>}
    </div>

    <div class="tarjeta__pie">
      <h3 class="tarjeta__nombre">{data.nombre}</h3>
      <p class="tarjeta__desc">{data.descripcionCorta}</p>
    </div>
  </a>
</article>

<style>
  .tarjeta {
    height: 100%;
  }

  .tarjeta__enlace {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--gris-fondo);
    border-radius: var(--radio);
    overflow: hidden;
    transition:
      transform var(--transicion),
      box-shadow var(--transicion);
  }

  .tarjeta__enlace:hover {
    transform: translateY(-4px);
    box-shadow: var(--sombra-alta);
  }

  .tarjeta__medio {
    position: relative;
    aspect-ratio: 1;
  }

  /* La imagen va en posición absoluta y no como hijo de un grid:
     un ítem de grid tiene min-height auto y estira el contenedor
     hasta la altura natural de la imagen, rompiendo el aspect-ratio.
     Con inset:0 + object-fit el recuadro siempre queda cuadrado.
     :global porque <Image> es un componente y el CSS con ámbito de
     Astro no alcanza al <img> que genera por dentro. */
  .tarjeta__medio :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: clamp(1rem, 3vw, 2rem);
    object-fit: contain;
  }

  .es-placeholder :global(img) {
    opacity: 0.55;
  }

  .tarjeta__aviso {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.2rem 0.6rem;
    font-family: var(--condensada);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--gris-medio);
    background: rgb(255 255 255 / 80%);
    border-radius: var(--radio-pill);
  }

  .tarjeta__pie {
    padding: 0 clamp(1rem, 2vw, 1.5rem) clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .tarjeta__nombre {
    font-family: var(--condensada);
    font-size: clamp(1.15rem, 1rem + 0.6vw, 1.5rem);
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    line-height: 1.1;
    color: var(--tinta);
  }

  .tarjeta__desc {
    margin-top: 0.5rem;
    font-size: var(--t-sm);
    line-height: 1.5;
    color: var(--gris-medio);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
