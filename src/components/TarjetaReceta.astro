---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  receta: CollectionEntry<'recetas'>;
  /** 'clara' sobre fondo blanco, 'oscura' sobre fondo verde */
  variante?: 'clara' | 'oscura';
  prioridad?: boolean;
}

const { receta, variante = 'clara', prioridad = false } = Astro.props;
const { data } = receta;
const href = `/recetas/${receta.id}`;
const total = data.tiempoPreparacion + data.tiempoCoccion;
---

<article class:list={['receta', `receta--${variante}`]}>
  <a href={href} class="receta__enlace">
    <div class="receta__medio">
      {
        data.imagen ? (
          <Image
            src={data.imagen}
            alt={data.imagenAlt ?? data.titulo}
            widths={[420, 760, 1100]}
            sizes="(max-width: 720px) 92vw, 46vw"
            loading={prioridad ? 'eager' : 'lazy'}
            class="receta__img"
          />
        ) : (
          <div class="receta__vacio" aria-hidden="true">
            <svg viewBox="0 0 48 48" width="48" height="48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="6" y="10" width="36" height="28" rx="4" />
              <circle cx="17" cy="20" r="3" />
              <path d="m10 33 10-9 7 6 5-4 6 7" />
            </svg>
          </div>
        )
      }
    </div>

    <div class="receta__pie">
      <h3 class="receta__titulo">{data.titulo}</h3>
      <p class="receta__meta">
        {total} min · {data.dificultad}
      </p>
    </div>
  </a>
</article>

<style>
  .receta {
    height: 100%;
  }

  .receta__enlace {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--gris-fondo);
    border-radius: var(--radio-lg);
    overflow: hidden;
    transition:
      transform var(--transicion),
      box-shadow var(--transicion);
  }

  .receta__enlace:hover {
    transform: translateY(-4px);
    box-shadow: var(--sombra-alta);
  }

  .receta__medio {
    position: relative;
    aspect-ratio: 4 / 3;
    background: var(--gris-fondo);
    overflow: hidden;
  }

  .receta__medio :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .receta__vacio {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: #d3d3d7;
  }

  .receta__pie {
    padding: clamp(1rem, 2.5vw, 1.75rem);
  }

  .receta__titulo {
    font-family: var(--condensada);
    font-size: clamp(1.1rem, 0.95rem + 0.7vw, 1.6rem);
    font-weight: 700;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    line-height: 1.1;
    color: var(--tinta);
  }

  .receta__meta {
    margin-top: 0.4rem;
    font-family: var(--condensada);
    font-size: var(--t-sm);
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--gris-medio);
  }
</style>
