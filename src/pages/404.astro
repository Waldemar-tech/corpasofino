---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ilus from '../assets/ilustraciones/hamburguesa-papas.png';
---

<Base
  titulo="Página no encontrada"
  descripcion="La página que buscas no existe o cambió de dirección."
  noindex={true}
>
  <section class="e404">
    <div class="contenedor e404__interior">
      <Image
        src={ilus}
        alt=""
        widths={[280, 520]}
        sizes="260px"
        loading="eager"
        class="e404__ilus"
      />
      <p class="e404__codigo">404</p>
      <h1>Esta página se nos quemó</h1>
      <p class="e404__texto">
        La dirección que buscas no existe o cambió de sitio. Vuelve al
        inicio o entra por una de nuestras dos líneas.
      </p>
      {/* Ya no hay un catálogo único: el catálogo vive dentro de cada
          marca, así que el 404 ofrece las dos puertas en vez de
          mandar a una redirección. */}
      <div class="e404__acciones">
        <a href="/" class="btn btn--verde">Ir al inicio</a>
        <a href="/los-lirios/productos" class="btn btn--contorno">Los Lirios</a>
        <a href="/foodie/productos" class="btn btn--contorno">Foodie</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .e404 {
    padding-block: var(--seccion);
  }

  .e404__interior {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 0.75rem;
  }

  .e404__ilus {
    width: clamp(180px, 28vw, 280px);
    height: auto;
    opacity: 0.7;
  }

  .e404__codigo {
    font-family: var(--display);
    font-size: clamp(3rem, 8vw, 5rem);
    line-height: 1;
    color: var(--ambar);
  }

  .e404 h1 {
    color: var(--verde-titulo);
  }

  .e404__texto {
    max-width: 44ch;
    font-size: var(--t-md);
    color: var(--gris-medio);
  }

  .e404__acciones {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
    margin-top: 1.25rem;
  }
</style>
