---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { GetStaticPaths } from 'astro';

import Base from '../../../layouts/Base.astro';
import TarjetaProducto from '../../../components/TarjetaProducto.astro';
import Distribuidores from '../../../components/Distribuidores.astro';
import Migas from '../../../components/Migas.astro';
import letPonleSabor from '../../../assets/lettering/ponle-sabor.png';

import { ORDEN_MARCAS, getMarca } from '../../../config/marcas.js';
import { migas } from '../../../lib/schema.js';

/**
 * Una sola plantilla sirve el catálogo de las dos marcas. Lo que
 * cambia entre Foodie y Los Lirios son los colores y el copy, y eso
 * sale de src/config/marcas.js. Cuando entre una tercera línea, no
 * hay que escribir otra página.
 */
export const getStaticPaths: GetStaticPaths = () =>
  ORDEN_MARCAS.map((slug) => ({ params: { marca: slug } }));

const { marca } = Astro.params;
const m = getMarca(marca!);

const productos = (await getCollection('productos'))
  .filter((p) => p.data.marca === marca)
  .sort((a, b) => a.data.orden - b.data.orden);

const ruta = [
  { nombre: 'Inicio', href: '/' },
  { nombre: m.nombre, href: `/${marca}` },
  { nombre: 'Productos', href: `/${marca}/productos` },
];
---

<Base
  titulo={`Productos ${m.nombre}`}
  descripcion={`Catálogo ${m.nombre} de Corporación Paso Fino: ${productos
    .map((p) => p.data.nombre.toLowerCase())
    .join(', ')}. ${m.descripcionCorta} Fabricado en Barquisimeto.`}
  marca={marca}
  jsonLd={migas(ruta)}
>
  <section class="portada">
    <div class="contenedor">
      <Migas ruta={ruta} />
      <div class="portada__cabeza">
        <div>
          <p class="portada__antetitulo">{m.posicionamiento}</p>
          <h1>Productos {m.nombre}</h1>
          <p class="portada__intro">{m.descripcion}</p>
        </div>
        {
          m.tieneLettering && (
            <Image
              src={letPonleSabor}
              alt=""
              widths={[260, 480]}
              sizes="(max-width: 720px) 52vw, 240px"
              loading="lazy"
              class="lettering portada__lettering"
            />
          )
        }
      </div>
    </div>
  </section>

  <section class="listado">
    <div class="contenedor">
      <ul class="rejilla">
        {
          productos.map((producto, i) => (
            <li>
              <TarjetaProducto producto={producto} prioridad={i < 4} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Distribuidores marca={marca} />
</Base>

<style>
  .portada {
    padding-block: clamp(1.5rem, 3vw, 2.5rem) clamp(2rem, 4vw, 3rem);
  }

  .portada__cabeza {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .portada__antetitulo {
    font-family: var(--condensada);
    font-size: var(--t-sm);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--marca-acento);
    margin-bottom: 0.6rem;
  }

  .portada h1 {
    color: var(--marca-titulo);
  }

  .portada__intro {
    max-width: 56ch;
    margin-top: 1rem;
    font-size: var(--t-md);
    color: var(--gris-medio);
  }

  .portada__lettering {
    width: clamp(150px, 20vw, 240px);
    height: auto;
  }

  .listado {
    padding-bottom: var(--seccion);
  }

  .rejilla {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.75rem);
  }

  @media (min-width: 640px) {
    .rejilla {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .rejilla {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
