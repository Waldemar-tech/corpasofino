---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import Distribuidores from '../components/Distribuidores.astro';

import heroBurger from '../assets/ilustraciones/hero-hamburguesa.png';
import mesaFamilia from '../assets/ilustraciones/mesa-familia.png';

import { SITE } from '../config/site.js';
import { listaMarcas } from '../config/marcas.js';
import { negocioLocal } from '../lib/schema.js';

/**
 * ─────────────────────────────────────────────────────────────
 *  HOME CORPORATIVO DE PASO FINO
 * ─────────────────────────────────────────────────────────────
 *
 *  Esta es la raíz del sitio y la página que más tráfico pagado va
 *  a recibir. Por eso NO es un selector de marcas bonito: es la
 *  página donde Paso Fino se presenta como fabricante y donde el
 *  bloque de distribuidores es el protagonista.
 *
 *  El argumento comercial central es que las dos líneas se venden
 *  juntas: un distribuidor cubre el segmento premium y el de uso
 *  diario con un solo proveedor, una factura y un despacho. Eso es
 *  más fuerte que vender cualquiera de las dos marcas por separado.
 */

const marcas = listaMarcas();
const productos = await getCollection('productos');

const conteo = Object.fromEntries(
  marcas.map((m) => [
    m.slug,
    productos.filter((p) => p.data.marca === m.slug).length,
  ])
);
const totalReferencias = productos.length;
---

<Base
  titulo="Fábrica de salsas y aderezos en Barquisimeto"
  descripcion={`${SITE.nombreLegal} fabrica salsas y aderezos en ${SITE.ciudad}, estado ${SITE.estado}. Dos líneas —Foodie y Los Lirios— y ${totalReferencias} referencias. Buscamos distribuidores en toda Venezuela.`}
  jsonLd={negocioLocal()}
>
  {/* ── HERO ─────────────────────────────────────────────── */}
  <section class="hero">
    <div class="contenedor hero__grid">
      <div class="hero__texto">
        <p class="hero__antetitulo">Fabricante venezolano · RIF {SITE.rif}</p>

        <h1 class="hero__titulo">
          Fabricamos las salsas<br />de la mesa venezolana
        </h1>

        <p class="hero__intro">
          Desde {SITE.ciudad}, estado {SITE.estado}, producimos dos líneas
          de salsas y aderezos: <strong>Foodie</strong> para el segmento
          premium y <strong>Los Lirios</strong> para el consumo diario.
          {' '}{totalReferencias} referencias, una sola planta, un solo
          proveedor.
        </p>

        <div class="hero__acciones">
          <a href="#distribuidores" class="btn btn--blanco">
            Quiero distribuir
          </a>
          <a href="#portafolio" class="btn hero__btn-fantasma">
            Ver el portafolio
            <Icono nombre="flecha" tamano={18} />
          </a>
        </div>
      </div>

      <div class="hero__imagen">
        <Image
          src={heroBurger}
          alt="Plato servido con salsas de Corporación Paso Fino"
          widths={[520, 860, 1200]}
          sizes="(max-width: 900px) 88vw, 44vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  {/* ── PORTAFOLIO DE MARCAS ─────────────────────────────── */}
  <section class="portafolio seccion" id="portafolio">
    <div class="contenedor">
      <div class="portafolio__cabeza">
        <h2>Dos líneas, dos bolsillos</h2>
        <p>
          La misma planta y los mismos controles detrás de dos marcas que
          le hablan a públicos distintos. Para un distribuidor eso
          significa cubrir el anaquel completo sin sumar proveedores.
        </p>
      </div>

      <ul class="portafolio__lista">
        {
          marcas.map((m) => (
            <li>
              <a
                href={`/${m.slug}`}
                class="marca-tarjeta"
                style={`--mt-color: ${m.color.principal}; --mt-oscuro: ${m.color.oscuro}; --mt-acento: ${m.color.acento}`}
              >
                <div class="marca-tarjeta__cabeza">
                  <p class="marca-tarjeta__etiqueta">{m.posicionamiento}</p>
                  <h3 class="marca-tarjeta__nombre">{m.nombre}</h3>
                </div>

                <p class="marca-tarjeta__texto">{m.descripcion}</p>

                <div class="marca-tarjeta__pie">
                  <span class="marca-tarjeta__conteo">
                    {conteo[m.slug]} referencias
                    {m.tieneRecetas && ' · con recetario'}
                  </span>
                  <span class="marca-tarjeta__cta">
                    Conocer {m.nombre}
                    <Icono nombre="flecha" tamano={18} />
                  </span>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ── LA EMPRESA ───────────────────────────────────────── */}
  <section class="empresa">
    <div class="contenedor empresa__grid">
      <div>
        <h2>Hecho en Barquisimeto</h2>
        <p class="empresa__texto">
          {SITE.nombreLegal} es una empresa venezolana que fabrica lo que
          vende. No importamos ni reetiquetamos: producimos acá, en el
          estado {SITE.estado}, con la cadena de proveedores y el empleo
          que eso implica.
        </p>
        <p class="empresa__texto">
          Esa es también la razón por la que podemos sostener dos líneas
          de precio a la vez y responder a un pedido sin depender de una
          aduana.
        </p>
        <a href="/nosotros" class="empresa__enlace">
          Conocer la empresa
          <Icono nombre="flecha" tamano={16} />
        </a>
      </div>

      <div class="empresa__ilustracion">
        <Image
          src={mesaFamilia}
          alt="Ilustración de personas compartiendo comida en la mesa"
          widths={[600, 1000, 1600]}
          sizes="(max-width: 900px) 92vw, 50vw"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  {/* ── DISTRIBUIDORES (B2B) — el objetivo del sitio ─────── */}
  <Distribuidores />
</Base>

<style>
  /* ── Hero ─────────────────────────────────────────────── */
  .hero {
    background: var(--verde);
    color: var(--blanco);
    padding-block: clamp(2.5rem, 6vw, 5.5rem);
    overflow: hidden;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .hero__antetitulo {
    font-family: var(--condensada);
    font-size: var(--t-sm);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ambar);
    margin-bottom: 1rem;
  }

  .hero__titulo {
    color: var(--blanco);
  }

  .hero__intro {
    max-width: 50ch;
    margin-top: 1.5rem;
    font-size: var(--t-md);
    line-height: 1.65;
    opacity: 0.94;
  }

  .hero__intro strong {
    font-weight: 700;
    color: var(--blanco);
  }

  .hero__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
  }

  .hero__btn-fantasma {
    color: var(--blanco);
    border-color: rgb(255 255 255 / 65%);
  }

  .hero__btn-fantasma:hover {
    background: var(--blanco);
    color: var(--verde);
    border-color: var(--blanco);
  }

  .hero__imagen :global(img) {
    width: 100%;
    height: auto;
  }

  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .hero__imagen {
      order: -1;
      max-width: 420px;
      margin-inline: auto;
    }
  }

  /* ── Portafolio ───────────────────────────────────────── */
  .portafolio__cabeza {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: start;
  }

  .portafolio__cabeza h2 {
    color: var(--verde-titulo);
  }

  .portafolio__cabeza p {
    max-width: 56ch;
    font-size: var(--t-md);
    line-height: 1.7;
    color: var(--gris-medio);
  }

  .portafolio__lista {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: clamp(1.25rem, 2.5vw, 2rem);
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  /* Cada tarjeta se pinta con el color de su propia marca —
     así el portafolio se lee de un vistazo como dos cosas
     distintas y no como dos enlaces iguales. */
  .marca-tarjeta {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    height: 100%;
    padding: clamp(1.75rem, 4vw, 2.75rem);
    color: var(--blanco);
    background: var(--mt-color);
    border-radius: var(--radio-lg);
    transition:
      transform var(--transicion),
      box-shadow var(--transicion);
  }

  .marca-tarjeta:hover {
    transform: translateY(-4px);
    box-shadow: var(--sombra-alta);
  }

  .marca-tarjeta__etiqueta {
    font-family: var(--condensada);
    font-size: var(--t-sm);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--mt-acento);
    margin-bottom: 0.5rem;
  }

  .marca-tarjeta__nombre {
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3.4rem);
    color: var(--blanco);
  }

  .marca-tarjeta__texto {
    flex: 1;
    font-size: var(--t-base);
    line-height: 1.65;
    opacity: 0.92;
  }

  .marca-tarjeta__pie {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: 1.25rem;
    border-top: 1.5px solid rgb(255 255 255 / 30%);
  }

  .marca-tarjeta__conteo {
    font-family: var(--condensada);
    font-size: var(--t-sm);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  .marca-tarjeta__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--condensada);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  @media (max-width: 820px) {
    .portafolio__cabeza {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
    }
  }

  /* ── La empresa ───────────────────────────────────────── */
  .empresa {
    background: var(--gris-fondo);
    padding-block: var(--seccion);
  }

  .empresa__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  .empresa__grid h2 {
    color: var(--verde-titulo);
  }

  .empresa__texto {
    max-width: 50ch;
    margin-top: 1.25rem;
    font-size: var(--t-md);
    line-height: 1.7;
    color: var(--gris-medio);
  }

  .empresa__enlace {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.75rem;
    font-family: var(--condensada);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--verde-titulo);
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .empresa__enlace:hover {
    color: var(--tinta);
  }

  .empresa__ilustracion :global(img) {
    width: 100%;
    height: auto;
  }

  @media (max-width: 900px) {
    .empresa__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
