---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import TarjetaProducto from '../components/TarjetaProducto.astro';
import TarjetaReceta from '../components/TarjetaReceta.astro';
import Distribuidores from '../components/Distribuidores.astro';

import heroBurger from '../assets/ilustraciones/hero-hamburguesa.png';
import mesaFamilia from '../assets/ilustraciones/mesa-familia.png';
import letHayUnaFoodie from '../assets/lettering/encuentra-foodie.png';
import letReceta from '../assets/lettering/receta-para-disfrutar.png';

import { SITE, ALIADOS } from '../config/site.js';
import { negocioLocal } from '../lib/schema.js';

const productos = (await getCollection('productos')).sort(
  (a, b) => a.data.orden - b.data.orden
);

const recetas = (await getCollection('recetas'))
  .filter((r) => r.data.destacada)
  .sort((a, b) => a.data.orden - b.data.orden)
  .slice(0, 2);

const titulo = 'Salsas y aderezos hechos en Barquisimeto';
const descripcion =
  'Corporación Paso Fino elabora las salsas y aderezos Foodie desde el estado Lara: ketchup, mayonesa, mostaza, salsa de ajo, inglesa, soya y vinagre. Buscamos distribuidores en toda Venezuela.';
---

<Base
  titulo={titulo}
  descripcion={descripcion}
  jsonLd={negocioLocal()}
>
  {/* ── HERO ─────────────────────────────────────────────── */}
  <section class="hero">
    <div class="contenedor hero__grid">
      <div class="hero__texto">
        <h1 class="hero__titulo">
          Hecho en Barquisimeto,<br />pensado para tu mesa.
        </h1>

        <p class="hero__intro">
          En {SITE.nombreLegal} elaboramos salsas y aderezos pensados para
          acompañar las comidas de todos los días. Desde el estado {SITE.estado}
          {' '}llevamos sabor, variedad y practicidad a hogares, comercios y
          negocios venezolanos.
        </p>

        <div class="hero__acciones">
          <a href="/productos" class="btn btn--blanco">
            Ver nuestros productos
          </a>
          <a href="#distribuidores" class="btn hero__btn-fantasma">
            ¿Eres distribuidor?
            <Icono nombre="flecha" tamano={18} />
          </a>
        </div>
      </div>

      <div class="hero__imagen">
        <Image
          src={heroBurger}
          alt="Hamburguesa con salsa Foodie servida en un plato"
          widths={[520, 860, 1200]}
          sizes="(max-width: 900px) 88vw, 44vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  {/* ── LA MARCA ─────────────────────────────────────────── */}
  <section class="marca seccion">
    <div class="contenedor">
      <div class="marca__cabeza">
        <h2 class="marca__titulo">
          Hay una Foodie para cada<br />forma de disfrutar
        </h2>
        <p class="marca__texto">
          Siete referencias que cubren desde el desayuno rápido hasta la
          parrilla del domingo. Producidas acá, con la misma receta cada
          vez, para que el sabor que te gustó la primera vez sea el mismo
          la próxima.
        </p>
      </div>

      <div class="marca__ilustracion">
        <Image
          src={mesaFamilia}
          alt="Ilustración de cuatro personas compartiendo comida en la mesa"
          widths={[700, 1200, 1600]}
          sizes="(max-width: 900px) 96vw, 78vw"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  {/* ── UN SABOR PARA CADA PLATO ─────────────────────────── */}
  <section class="sabor" aria-labelledby="sabor-titulo">
    <div class="contenedor sabor__grid">
      <div class="sabor__texto">
        <h2 id="sabor-titulo">Un sabor para<br />cada plato</h2>
        <p>
          Descubre la variedad Foodie y encuentra el acompañante perfecto
          para cada receta.
        </p>
        <a href="/productos" class="btn btn--blanco">Nuestros productos</a>
      </div>
    </div>
  </section>

  {/* ── PRODUCTOS ────────────────────────────────────────── */}
  <section class="productos seccion" aria-labelledby="productos-titulo">
    <div class="contenedor">
      <h2 id="productos-titulo" class="solo-lectores">Nuestros productos</h2>
      <ul class="rejilla-productos">
        {
          productos.map((producto, i) => (
            <li>
              <TarjetaProducto producto={producto} prioridad={i < 4} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ── DÓNDE CONSEGUIRLO ────────────────────────────────── */}
  <section class="aliados seccion" aria-labelledby="aliados-titulo">
    <div class="contenedor aliados__interior">
      <Image
        src={letHayUnaFoodie}
        alt=""
        widths={[420, 700]}
        sizes="(max-width: 720px) 74vw, 380px"
        loading="lazy"
        class="lettering aliados__lettering"
      />

      {
        ALIADOS.length > 0 ? (
          <Fragment>
            <h2 id="aliados-titulo" class="aliados__titulo">
              Comercios aliados
            </h2>
            <ul class="aliados__lista">
              {ALIADOS.map((a) => (
                <li>
                  <img
                    src={`/aliados/${a.logo}`}
                    alt={a.nombre}
                    height="48"
                    loading="lazy"
                  />
                </li>
              ))}
            </ul>
          </Fragment>
        ) : (
          <Fragment>
            <h2 id="aliados-titulo" class="aliados__titulo">
              ¿Dónde conseguir Foodie?
            </h2>
            <p class="aliados__texto">
              Estamos ampliando la red de comercios que venden Foodie en todo
              el país. Escríbenos y te decimos cuál te queda más cerca — o
              cómo llevarlo a tu propio negocio.
            </p>
            <a href="/contacto" class="btn btn--contorno">
              Consultar disponibilidad
            </a>
          </Fragment>
        )
      }
    </div>
  </section>

  {/* ── MODO FOODIE (RECETAS) ────────────────────────────── */}
  <section class="modo" aria-labelledby="modo-titulo">
    <div class="contenedor modo__interior">
      <div class="modo__cabeza">
        <h2 id="modo-titulo">Modo Foodie</h2>
        <Image
          src={letReceta}
          alt=""
          widths={[320, 560]}
          sizes="(max-width: 720px) 60vw, 300px"
          loading="lazy"
          class="lettering modo__lettering"
        />
      </div>

      <ul class="modo__recetas">
        {
          recetas.map((receta) => (
            <li>
              <TarjetaReceta receta={receta} variante="oscura" />
            </li>
          ))
        }
      </ul>

      <div class="modo__pie">
        <a href="/recetas" class="btn btn--blanco">Descubre más recetas</a>
      </div>
    </div>
  </section>

  {/* ── DISTRIBUIDORES (B2B) ─────────────────────────────── */}
  <Distribuidores />
</Base>

<style>
  /* ── Hero ─────────────────────────────────────────────── */
  .hero {
    background: var(--verde);
    color: var(--blanco);
    padding-block: clamp(2.5rem, 6vw, 5.5rem);
    overflow: hidden;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .hero__titulo {
    color: var(--blanco);
  }

  .hero__intro {
    max-width: 46ch;
    margin-top: 1.5rem;
    font-size: var(--t-md);
    line-height: 1.65;
    opacity: 0.94;
  }

  .hero__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
  }

  .hero__btn-fantasma {
    color: var(--blanco);
    border-color: rgb(255 255 255 / 65%);
  }

  .hero__btn-fantasma:hover {
    background: var(--blanco);
    color: var(--verde);
    border-color: var(--blanco);
  }

  .hero__imagen :global(img) {
    width: 100%;
    height: auto;
  }

  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .hero__imagen {
      order: -1;
      max-width: 460px;
      margin-inline: auto;
    }
  }

  /* ── Marca ────────────────────────────────────────────── */
  .marca__cabeza {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: end;
  }

  .marca__titulo {
    color: var(--verde-titulo);
  }

  .marca__texto {
    max-width: 52ch;
    font-size: var(--t-md);
    line-height: 1.7;
    color: var(--gris-medio);
  }

  .marca__ilustracion {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .marca__ilustracion :global(img) {
    width: 100%;
    max-width: 1100px;
    margin-inline: auto;
    height: auto;
  }

  @media (max-width: 820px) {
    .marca__cabeza {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
    }
  }

  /* ── Un sabor para cada plato ─────────────────────────── */
  .sabor {
    background: var(--verde-brillante);
    color: var(--blanco);
    padding-block: clamp(3rem, 7vw, 6rem);
  }

  .sabor__grid {
    display: grid;
    place-items: center;
    text-align: center;
  }

  .sabor__texto h2 {
    color: var(--blanco);
  }

  .sabor__texto p {
    max-width: 46ch;
    margin: 1.25rem auto 0;
    font-size: var(--t-md);
    opacity: 0.95;
  }

  .sabor__texto .btn {
    margin-top: 2rem;
  }

  /* ── Productos ────────────────────────────────────────── */
  /* Cuatro columnas como máximo: con siete productos el grid queda
     4 + 3, que se lee mejor que 5 + 2 y deja las tarjetas a un
     tamaño donde el envase se aprecia. */
  .rejilla-productos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.75rem);
  }

  @media (min-width: 640px) {
    .rejilla-productos {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .rejilla-productos {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* ── Aliados ──────────────────────────────────────────── */
  .aliados {
    background: var(--gris-fondo);
  }

  .aliados__interior {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.25rem;
  }

  .aliados__lettering {
    width: clamp(240px, 34vw, 380px);
    height: auto;
    margin-bottom: 0.5rem;
  }

  .aliados__titulo {
    color: var(--tinta);
  }

  .aliados__texto {
    max-width: 56ch;
    font-size: var(--t-md);
    color: var(--gris-medio);
  }

  .aliados__lista {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
    margin-top: 1rem;
  }

  .aliados__lista img {
    height: 48px;
    width: auto;
    filter: grayscale(1);
    opacity: 0.65;
    transition:
      filter var(--transicion),
      opacity var(--transicion);
  }

  .aliados__lista img:hover {
    filter: grayscale(0);
    opacity: 1;
  }

  /* ── Modo Foodie ──────────────────────────────────────── */
  .modo {
    background: var(--verde-oscuro);
    color: var(--blanco);
    padding-block: var(--seccion);
  }

  .modo__cabeza {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .modo__cabeza h2 {
    color: var(--blanco);
  }

  .modo__lettering {
    width: clamp(190px, 24vw, 300px);
    height: auto;
  }

  .modo__recetas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }

  .modo__pie {
    display: flex;
    justify-content: flex-end;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  @media (max-width: 640px) {
    .modo__pie {
      justify-content: center;
    }
  }
</style>
