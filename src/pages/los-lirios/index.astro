---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

import Base from '../../layouts/Base.astro';
import Icono from '../../components/Icono.astro';
import Migas from '../../components/Migas.astro';

import flor from '../../assets/brand/lirio-flor.png';
import ondas from '../../assets/lirios/fondos/hero-ondas.png';
import bandaCta from '../../assets/lirios/fondos/banda-cta.png';
import envases from '../../assets/lirios/ui/envases-grupo.png';
import botella from '../../assets/lirios/ui/botella.png';

import { SITE, ALIADOS } from '../../config/site.js';
import { getMarca } from '../../config/marcas.js';
import { enlaceWhatsApp } from '../../lib/whatsapp.js';
import { migas } from '../../lib/schema.js';
import { slugDe } from '../../lib/rutas.js';

/**
 * ─────────────────────────────────────────────────────────────
 *  HOME DE LOS LIRIOS
 * ─────────────────────────────────────────────────────────────
 *  Maquetado desde el PDF «Home - Los Lirios».
 *
 *  Identidad propia y bien distinta de Foodie: rojo, ondas
 *  orgánicas, amarillo de acento y tipografía redondeada (Fredoka).
 *  Eso es correcto en una casa de marcas — la línea de uso diario no
 *  tiene por qué parecerse a la premium.
 *
 *  El copy del diseño venía en lorem ipsum salvo el párrafo de
 *  presentación, que sí traía texto final y se respetó tal cual.
 */

const MARCA = 'los-lirios';
const m = getMarca(MARCA);

// La etiqueta de cada envase viaja en el frontmatter del producto
// (campo `etiqueta`), así que aquí no hay ningún mapa que mantener:
// se agrega un producto nuevo y su etiqueta aparece sola.
const productos = (await getCollection('productos'))
  .filter((p) => p.data.marca === MARCA)
  .sort((a, b) => a.data.orden - b.data.orden)
  .map((p) => ({ ...p, slug: slugDe(p.id) }));

const ruta = [
  { nombre: 'Inicio', href: '/' },
  { nombre: m.nombre, href: `/${MARCA}` },
];

const wa = enlaceWhatsApp('distribuidor');

// Los tres marcos inclinados del diseño. Cada uno lleva el color de
// un producto distinto, que es lo que le da el ritmo a la sección.
const momentos = [
  { titulo: 'En la parrilla del domingo', color: 'var(--marca-acento)', giro: '-3deg' },
  { titulo: 'En el perro caliente de la esquina', color: 'var(--marca-brillante)', giro: '1.5deg' },
  { titulo: 'En la arepa de todos los días', color: 'var(--marca)', giro: '-2deg' },
];
---

<Base
  titulo="Los Lirios — salsas y preparados de uso diario"
  descripcion={`Los Lirios es la línea de preparados de ${SITE.nombreLegal}: salsa a base de tomate, preparado mayonesa, salsa a base de mostaza, salsa con sabor a maíz y BBQ. Hecha en ${SITE.ciudad}, estado ${SITE.estado}.`}
  marca={MARCA}
  jsonLd={migas(ruta)}
>
  {/* ── HERO ─────────────────────────────────────────────── */}
  <section class="hero">
    <Image
      src={ondas}
      alt=""
      widths={[900, 1600, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="hero__fondo"
      aria-hidden="true"
    />

    <div class="contenedor hero__interior">
      <Migas ruta={ruta} variante="oscura" />

      <h1 class="hero__titulo">El sabor de<br />todos los días</h1>

      <div class="hero__acciones">
        <a href="/los-lirios/productos" class="pastilla pastilla--amarilla">
          Ver productos
        </a>
        <a href="#distribuidores" class="pastilla pastilla--blanca">
          ¿Eres distribuidor?
        </a>
      </div>
    </div>
  </section>

  {/* ── PRESENTACIÓN ─────────────────────────────────────── */}
  <section class="intro">
    <div class="contenedor intro__grid">
      <div class="intro__envases">
        <Image
          src={envases}
          alt="Envases de la línea Los Lirios"
          widths={[420, 760]}
          sizes="(max-width: 900px) 70vw, 38vw"
          loading="lazy"
        />
      </div>

      <div class="intro__texto">
        <h2 class="intro__titulo">
          Sabor que <em>rinde</em>,<br />precio que cuadra
        </h2>

        <p>
          En {SITE.nombreLegal} elaboramos salsas y aderezos pensados
          para acompañar las comidas de todos los días.
        </p>
        <p>
          Desde el estado {SITE.estado} llevamos sabor, variedad y
          practicidad a hogares, comercios y negocios venezolanos.
        </p>

        <a href="/los-lirios/productos" class="pastilla pastilla--amarilla">
          Conocer la línea
        </a>
      </div>
    </div>
  </section>

  {/* ── MOMENTOS ─────────────────────────────────────────── */}
  <section class="momentos seccion">
    <div class="contenedor">
      <div class="momentos__cabeza">
        <Image
          src={flor}
          alt=""
          widths={[80, 160]}
          sizes="56px"
          loading="lazy"
          class="momentos__flor"
        />
        <h2 class="momentos__titulo">Donde hay comida, hay Los Lirios</h2>
      </div>

      <ul class="momentos__lista">
        {
          momentos.map((mo) => (
            <li class="momento" style={`--m-borde: ${mo.color}; --m-giro: ${mo.giro}`}>
              <div class="momento__marco">
                <span class="momento__pendiente">Fotografía pendiente</span>
              </div>
              <p class="momento__titulo">{mo.titulo}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ── PRODUCTOS ────────────────────────────────────────── */}
  <section class="productos" aria-labelledby="productos-titulo">
    <div class="contenedor">
      <div class="productos__cabeza">
        <h2 id="productos-titulo" class="productos__titulo">Nuestros productos</h2>
        <div class="productos__flechas">
          <button type="button" class="flecha" data-dir="-1" aria-label="Ver productos anteriores">
            <Icono nombre="chevron" tamano={22} />
          </button>
          <button type="button" class="flecha" data-dir="1" aria-label="Ver más productos">
            <Icono nombre="chevron" tamano={22} />
          </button>
        </div>
      </div>

      <ul class="carrusel" id="carrusel-productos">
        {
          productos.map((p) => (
            <li class="tarjeta">
              <a href={`/${MARCA}/productos/${p.slug}`} class="tarjeta__enlace">
                <div class="tarjeta__envase">
                  <Image
                    src={botella}
                    alt=""
                    widths={[160, 320]}
                    sizes="140px"
                    loading="lazy"
                    class="tarjeta__botella"
                  />
                  {p.data.etiqueta && (
                    <Image
                      src={p.data.etiqueta}
                      alt={p.data.nombre}
                      widths={[240, 460]}
                      sizes="200px"
                      loading="lazy"
                      class="tarjeta__etiqueta"
                    />
                  )}
                </div>
                <p class="tarjeta__desc">{p.data.descripcionCorta}</p>
                <span class="tarjeta__cta">
                  Ver producto
                  <Icono nombre="flecha" tamano={16} />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ── DÓNDE CONSEGUIRLO ────────────────────────────────── */}
  <section class="donde" aria-labelledby="donde-titulo">
    <svg class="donde__onda" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true">
      <path
        d="M0,46 C120,10 240,4 360,26 C480,48 560,74 700,68 C840,62 900,20 1030,16 C1160,12 1280,44 1440,30 L1440,90 L0,90 Z"
        fill="currentColor"></path>
    </svg>

    <div class="contenedor donde__interior">
      {
        ALIADOS.length > 0 ? (
          <Fragment>
            <h2 id="donde-titulo" class="donde__titulo">Comercios aliados</h2>
            <ul class="donde__lista">
              {ALIADOS.map((a) => (
                <li>
                  <img src={`/aliados/${a.logo}`} alt={a.nombre} height="44" loading="lazy" />
                </li>
              ))}
            </ul>
          </Fragment>
        ) : (
          <Fragment>
            <h2 id="donde-titulo" class="donde__titulo">
              ¿Dónde conseguir Los Lirios?
            </h2>
            <p class="donde__texto">
              Estamos ampliando la red de comercios que venden la línea en
              todo el país. Escríbenos y te decimos cuál te queda más cerca.
            </p>
            <a href="/contacto" class="pastilla pastilla--vino">
              Consultar disponibilidad
            </a>
          </Fragment>
        )
      }
    </div>
  </section>

  {/* ── DISTRIBUIDORES (B2B) ─────────────────────────────── */}
  <section class="b2b" id="distribuidores" aria-labelledby="b2b-titulo">
    <div class="b2b__banda">
      <Image
        src={bandaCta}
        alt=""
        widths={[900, 1600, 2400]}
        sizes="100vw"
        loading="lazy"
        class="b2b__fondo"
        aria-hidden="true"
      />

      <div class="contenedor b2b__interior">
        <div class="b2b__texto">
          <p class="b2b__antetitulo">Mayoristas y distribuidores</p>
          <h2 id="b2b-titulo" class="b2b__titulo">
            Llévanos a tu<br />zona de venta
          </h2>
          <p class="b2b__parrafo">
            Buscamos distribuidores, supermercados y negocios que quieran
            crecer junto a nosotros. Producción nacional en {SITE.ciudad},
            {/* El nombre legal ya termina en punto («C.A.»); añadir otro
                deja dos seguidos. */}
            precios escalonados por volumen y el respaldo formal de
            {' '}{SITE.nombreLegal}
          </p>

          <div class="b2b__acciones">
            <a
              class="pastilla pastilla--amarilla"
              href={wa}
              data-wa="distribuidor"
              data-wa-etiqueta="Home Los Lirios"
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icono nombre="whatsapp" tamano={20} />
              Solicitar catálogo
            </a>
            <a href="/contacto" class="pastilla pastilla--blanca">Contactar</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ── Píldoras (los botones de esta marca son redondos) ── */
  .pastilla {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.9rem 1.9rem;
    font-family: var(--marca-display);
    font-stretch: var(--marca-display-ancho);
    font-size: var(--t-base);
    font-weight: 600;
    line-height: 1;
    border-radius: var(--radio-pill);
    transition:
      transform var(--transicion),
      filter var(--transicion);
  }

  .pastilla:hover {
    transform: translateY(-2px);
    filter: brightness(0.94);
  }

  .pastilla--amarilla {
    background: var(--marca-acento);
    color: var(--marca);
  }

  .pastilla--blanca {
    background: var(--blanco);
    color: var(--marca);
  }

  .pastilla--vino {
    background: var(--marca);
    color: var(--blanco);
  }

  /* ── Hero ─────────────────────────────────────────────── */
  .hero {
    position: relative;
    display: grid;
    place-items: center;
    min-height: clamp(460px, 72vh, 780px);
    background: var(--marca);
    overflow: hidden;
  }

  .hero__fondo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__interior {
    position: relative;
    display: grid;
    justify-items: center;
    text-align: center;
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }

  .hero__titulo {
    margin-top: clamp(1.5rem, 4vw, 3rem);
    font-family: var(--marca-display);
    font-stretch: var(--marca-display-ancho);
    font-weight: 700;
    font-size: clamp(2.6rem, 1.4rem + 5.4vw, 6rem);
    line-height: 0.98;
    letter-spacing: 0.005em;
    color: var(--blanco);
  }

  .hero__acciones {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
    margin-top: clamp(1.75rem, 4vw, 2.75rem);
  }

  /* ── Presentación ─────────────────────────────────────── */
  .intro {
    background: var(--marca-claro);
    padding-block: var(--seccion);
  }

  .intro__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  .intro__envases :global(img) {
    width: 100%;
    max-width: 460px;
    margin-inline: auto;
    height: auto;
  }

  .intro__titulo {
    font-family: var(--marca-display);
    font-stretch: var(--marca-display-ancho);
    font-weight: 600;
    font-size: clamp(1.9rem, 1.2rem + 2.6vw, 3.4rem);
    line-height: 1.05;
    text-transform: none;
    color: var(--marca-oscuro);
  }

  .intro__titulo em {
    font-style: normal;
    color: var(--marca);
  }

  .intro__texto p {
    max-width: 52ch;
    margin-top: 1.25rem;
    font-size: var(--t-base);
    line-height: 1.7;
    color: var(--marca-oscuro);
  }

  .intro__texto .pastilla {
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
  }

  @media (max-width: 900px) {
    .intro__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ── Momentos ─────────────────────────────────────────── */
  .momentos__cabeza {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .momentos__flor {
    width: clamp(44px, 5vw, 64px);
    height: auto;
  }

  .momentos__titulo {
    font-family: var(--marca-display);
    font-stretch: var(--marca-display-ancho);
    font-weight: 600;
    font-size: clamp(1.6rem, 1.1rem + 2vw, 2.8rem);
    line-height: 1.1;
    text-transform: none;
    color: var(--marca-oscuro);
  }

  .momentos__lista {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }

  /* Los marcos van ligeramente girados, como fotos pegadas en una
     pared. Es el gesto que le da carácter a la sección. */
  .momento {
    display: grid;
    gap: 1rem;
    rotate: var(--m-giro);
  }

  .momento:nth-child(even) {
    margin-top: clamp(1rem, 3vw, 2.5rem);
  }

  .momento__marco {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    border: 12px solid var(--m-borde);
    background: var(--gris-fondo);
  }

  .momento__pendiente {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gris-borde);
  }

  .momento__titulo {
    font-family: var(--marca-display);
    font-stretch: var(--marca-display-ancho);
    font-weight: 500;
    font-size: var(--t-base);
    color: var(--marca-oscuro);
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .momento {
      rotate: none;
    }
  }

  /* ── Productos ────────────────────────────────────────── */
  .productos {
    padding-block: 0 var(--seccion);
  }

  .productos__cabeza {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .productos__titulo {
    font-family: var(--marca-display);
    font-stretch: var(--marca-display-ancho);
    font-weight: 600;
    font-size: clamp(1.6rem, 1.1rem + 2vw, 2.8rem);
    text-transform: none;
    color: var(--marca-oscuro);
  }

  .productos__flechas {
    display: flex;
    gap: 0.6rem;
  }

  .flecha {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    color: var(--marca-oscuro);
    border: 2px solid currentColor;
    border-radius: 50%;
    transition:
      background var(--transicion),
      color var(--transicion);
  }

  .flecha[data-dir='-1'] :global(svg) {
    rotate: 180deg;
  }

  .flecha:hover {
    background: var(--marca);
    color: var(--blanco);
    border-color: var(--marca);
  }

  .carrusel {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(230px, 1fr);
    gap: clamp(1rem, 2vw, 1.75rem);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding-bottom: 1rem;
    scrollbar-width: thin;
  }

  .tarjeta {
    scroll-snap-align: start;
  }

  .tarjeta__enlace {
    display: grid;
    /* minmax(0, …) y no «1fr» a secas: una columna «auto» se dimensiona
       al max-content de la imagen del envase (cientos de píxeles) y
       revienta la tarjeta hacia los lados. */
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
    height: 100%;
    padding: 1.25rem;
    border-radius: var(--radio-lg);
    transition: background var(--transicion);
  }

  .tarjeta__enlace:hover {
    background: var(--marca-claro);
  }

  .tarjeta__envase {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
  }

  /* La botella se posiciona en absoluto para que su tamaño natural no
     participe en el cálculo del ancho de la tarjeta. */
  .tarjeta__botella {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* La etiqueta se monta sobre el envase, como en el diseño. */
  .tarjeta__etiqueta {
    position: absolute;
    bottom: 12%;
    left: 50%;
    translate: -50% 0;
    width: 92%;
    height: auto;
  }

  .tarjeta__desc {
    font-size: var(--t-sm);
    line-height: 1.55;
    color: var(--marca-oscuro);
    opacity: 0.85;
  }

  .tarjeta__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--marca-display);
    font-stretch: var(--marca-display-ancho);
    font-weight: 600;
    font-size: var(--t-sm);
    color: var(--marca);
  }

  /* ── Dónde conseguirlo ────────────────────────────────── */
  .donde {
    position: relative;
    color: var(--marca-acento);
    background: var(--marca-acento);
    padding-block: clamp(3rem, 6vw, 5rem);
  }

  /* La onda superior repite el gesto del diseño sin depender de una
     imagen: así la sección puede llevar contenido real encima. */
  .donde__onda {
    position: absolute;
    top: -1px;
    left: 0;
    width: 100%;
    height: clamp(40px, 5vw, 90px);
    translate: 0 -100%;
    display: block;
  }

  .donde__interior {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1rem;
  }

  .donde__titulo {
    font-family: var(--marca-display);
    font-stretch: var(--marca-display-ancho);
    font-weight: 700;
    font-size: clamp(1.6rem, 1.1rem + 2vw, 2.8rem);
    text-transform: none;
    color: var(--marca-oscuro);
  }

  .donde__texto {
    max-width: 54ch;
    font-size: var(--t-base);
    line-height: 1.65;
    color: var(--marca-oscuro);
  }

  .donde__lista {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
    margin-top: 0.5rem;
  }

  .donde .pastilla {
    margin-top: 0.75rem;
  }

  /* ── B2B ──────────────────────────────────────────────── */
  /* En el diseño esta banda va a sangre, pegada a la franja amarilla
     y con las esquinas superiores redondeadas, no como tarjeta suelta
     sobre un fondo blanco. */
  .b2b {
    background: var(--marca-acento);
  }

  .b2b__banda {
    position: relative;
    overflow: hidden;
    border-radius: var(--radio-lg) var(--radio-lg) 0 0;
    background: var(--marca-oscuro);
  }

  .b2b__fondo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* El fondo trae salpicaduras amarillas justo donde cae el párrafo.
     Un velo del vino de la marca por el lado del texto devuelve el
     contraste sin apagar la ilustración. */
  .b2b__banda::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      color-mix(in srgb, var(--marca-oscuro) 78%, transparent) 0%,
      color-mix(in srgb, var(--marca-oscuro) 58%, transparent) 36%,
      transparent 60%
    );
  }

  /* El velo es hermano posterior del contenido, así que sin esto se
     pintaría por encima del texto y de los botones. */
  .b2b__interior {
    z-index: 1;
  }

  .b2b__interior {
    position: relative;
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }

  .b2b__texto {
    max-width: 46ch;
  }

  .b2b__antetitulo {
    font-size: var(--t-sm);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--marca-acento);
    margin-bottom: 0.75rem;
  }

  .b2b__titulo {
    font-family: var(--marca-display);
    font-stretch: var(--marca-display-ancho);
    font-weight: 600;
    font-size: clamp(1.9rem, 1.2rem + 2.8vw, 3.6rem);
    line-height: 1.02;
    text-transform: none;
    color: var(--blanco);
  }

  .b2b__parrafo {
    margin-top: 1.25rem;
    font-size: var(--t-base);
    line-height: 1.7;
    color: var(--blanco);
    opacity: 0.94;
  }

  .b2b__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
  }
</style>

<script>
  // Carrusel por desplazamiento: sin librería, respeta el teclado y
  // funciona con gesto táctil de forma nativa.
  const carrusel = document.getElementById('carrusel-productos');
  const flechas = document.querySelectorAll<HTMLButtonElement>('.flecha');

  if (carrusel && flechas.length) {
    flechas.forEach((boton) => {
      boton.addEventListener('click', () => {
        const dir = Number(boton.dataset.dir ?? 1);
        const primera = carrusel.querySelector<HTMLElement>('.tarjeta');
        const paso = primera ? primera.offsetWidth + 24 : carrusel.clientWidth * 0.8;
        carrusel.scrollBy({ left: paso * dir, behavior: 'smooth' });
      });
    });

    // Las flechas se apagan cuando ya no hay a dónde ir.
    const actualizar = () => {
      const fin = carrusel.scrollWidth - carrusel.clientWidth - 4;
      flechas.forEach((b) => {
        const dir = Number(b.dataset.dir ?? 1);
        const tope = dir < 0 ? carrusel.scrollLeft <= 4 : carrusel.scrollLeft >= fin;
        b.disabled = tope;
        b.style.opacity = tope ? '0.35' : '1';
      });
    };

    carrusel.addEventListener('scroll', actualizar, { passive: true });
    window.addEventListener('resize', actualizar);
    actualizar();
  }
</script>
