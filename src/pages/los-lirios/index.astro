---
import { getCollection } from 'astro:content';

import Base from '../../layouts/Base.astro';
import Icono from '../../components/Icono.astro';
import TarjetaProducto from '../../components/TarjetaProducto.astro';
import Distribuidores from '../../components/Distribuidores.astro';
import Migas from '../../components/Migas.astro';

import { SITE } from '../../config/site.js';
import { getMarca } from '../../config/marcas.js';
import { migas } from '../../lib/schema.js';

/**
 * Home de Los Lirios.
 *
 * Nota para quien retome esto: la identidad visual de Los Lirios es
 * PROVISIONAL — se deriva de la paleta declarada en marcas.js. Cuando
 * el diseñador entregue logo y colores, se cambian esos cinco valores
 * y esta página se repinta sola. La estructura no hay que tocarla.
 *
 * Por eso esta página se apoya en tipografía y color en lugar de en
 * ilustraciones: no hay assets propios de la marca todavía, y prefiero
 * una página honesta y sobria a una con imágenes prestadas de Foodie.
 */

const MARCA = 'los-lirios';
const m = getMarca(MARCA);

const productos = (await getCollection('productos'))
  .filter((p) => p.data.marca === MARCA)
  .sort((a, b) => a.data.orden - b.data.orden);

const ruta = [
  { nombre: 'Inicio', href: '/' },
  { nombre: m.nombre, href: `/${MARCA}` },
];

const razones = [
  {
    titulo: 'Rinde',
    texto:
      'Formulada para la cocina que produce todos los días, no para la que cocina una vez a la semana.',
  },
  {
    titulo: 'Precio accesible',
    texto:
      'La línea pensada para que el sabor no dependa del presupuesto de la quincena.',
  },
  {
    titulo: 'Misma planta, mismo control',
    texto: `Sale de la misma fábrica que Foodie, en ${SITE.ciudad}, con los mismos controles.`,
  },
];
---

<Base
  titulo="Los Lirios — preparados y salsas de uso diario"
  descripcion={`Los Lirios es la línea de preparados de ${SITE.nombreLegal}: salsa de tomate, mayonesa, mostaza, salsa de ajo y salsa rosada. Hecha en Barquisimeto, estado Lara.`}
  marca={MARCA}
  jsonLd={migas(ruta)}
>
  {/* ── HERO ─────────────────────────────────────────────── */}
  <section class="hero">
    <div class="contenedor hero__migas">
      <Migas ruta={ruta} variante="oscura" />
    </div>

    <div class="contenedor hero__interior">
      <p class="hero__antetitulo">{m.posicionamiento}</p>
      <h1 class="hero__titulo">El sabor de<br />todos los días</h1>
      <p class="hero__intro">{m.descripcion}</p>

      <div class="hero__acciones">
        <a href="/los-lirios/productos" class="btn btn--blanco">
          Ver productos Los Lirios
        </a>
        <a href="#distribuidores" class="btn hero__btn-fantasma">
          ¿Eres distribuidor?
          <Icono nombre="flecha" tamano={18} />
        </a>
      </div>
    </div>
  </section>

  {/* ── POR QUÉ ──────────────────────────────────────────── */}
  <section class="razones seccion">
    <div class="contenedor">
      <div class="razones__cabeza">
        <h2>La línea que trabaja</h2>
        <p>
          Los Lirios es la respuesta de {SITE.nombreCorto} para el
          consumo diario: presentaciones que rinden, sabor parejo y un
          precio que le sirve tanto a la casa como al negocio que compra
          por caja.
        </p>
      </div>

      <ul class="razones__lista">
        {
          razones.map((r, i) => (
            <li class="razon">
              <span class="razon__num" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3>{r.titulo}</h3>
              <p>{r.texto}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ── PRODUCTOS ────────────────────────────────────────── */}
  <section class="productos">
    <div class="contenedor">
      <div class="productos__cabeza">
        <h2>Nuestros productos</h2>
        <a href="/los-lirios/productos" class="productos__todos">
          Ver el catálogo completo
          <Icono nombre="flecha" tamano={16} />
        </a>
      </div>

      <ul class="rejilla">
        {
          productos.map((producto, i) => (
            <li>
              <TarjetaProducto producto={producto} prioridad={i < 4} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ── PUENTE A FOODIE ──────────────────────────────────── */}
  <section class="puente">
    <div class="contenedor puente__interior">
      <div>
        <p class="puente__antetitulo">También de Paso Fino</p>
        <h2>¿Buscas la línea premium?</h2>
        <p class="puente__texto">
          Foodie es la otra línea de la corporación: salsas y aderezos de
          mesa con siete referencias y su propio recetario.
        </p>
      </div>
      <a href="/foodie" class="btn btn--contorno puente__btn">
        Conocer Foodie
        <Icono nombre="flecha" tamano={18} />
      </a>
    </div>
  </section>

  {/* ── DISTRIBUIDORES (B2B) ─────────────────────────────── */}
  <Distribuidores marca={MARCA} />
</Base>

<style>
  /* ── Hero ─────────────────────────────────────────────── */
  .hero {
    background: var(--marca);
    color: var(--blanco);
    padding-block: clamp(1.25rem, 3vw, 2rem) clamp(3rem, 8vw, 7rem);
  }

  .hero__migas {
    margin-bottom: clamp(2rem, 5vw, 4rem);
  }

  .hero__antetitulo {
    font-family: var(--condensada);
    font-size: var(--t-sm);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--marca-acento);
    margin-bottom: 1rem;
  }

  .hero__titulo {
    color: var(--blanco);
    font-size: var(--t-2xl);
  }

  .hero__intro {
    max-width: 52ch;
    margin-top: 1.5rem;
    font-size: var(--t-md);
    line-height: 1.65;
    opacity: 0.94;
  }

  .hero__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
  }

  .hero__btn-fantasma {
    color: var(--blanco);
    border-color: rgb(255 255 255 / 65%);
  }

  .hero__btn-fantasma:hover {
    background: var(--blanco);
    color: var(--marca);
    border-color: var(--blanco);
  }

  /* ── Razones ──────────────────────────────────────────── */
  .razones__cabeza {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: start;
  }

  .razones__cabeza h2 {
    color: var(--marca-titulo);
  }

  .razones__cabeza p {
    max-width: 54ch;
    font-size: var(--t-md);
    line-height: 1.7;
    color: var(--gris-medio);
  }

  .razones__lista {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .razon {
    padding-top: 1.25rem;
    border-top: 3px solid var(--marca);
  }

  .razon__num {
    display: block;
    font-family: var(--display);
    font-size: 1.6rem;
    color: var(--marca-acento);
    line-height: 1;
    margin-bottom: 0.6rem;
  }

  .razon h3 {
    font-family: var(--condensada);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--tinta);
  }

  .razon p {
    margin-top: 0.6rem;
    font-size: var(--t-sm);
    line-height: 1.65;
    color: var(--gris-medio);
  }

  @media (max-width: 820px) {
    .razones__cabeza {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
    }
  }

  /* ── Productos ────────────────────────────────────────── */
  .productos {
    background: var(--gris-fondo);
    padding-block: var(--seccion);
  }

  .productos__cabeza {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .productos__cabeza h2 {
    color: var(--marca-titulo);
  }

  .productos__todos {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--condensada);
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--marca-titulo);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .productos__todos:hover {
    color: var(--tinta);
  }

  .rejilla {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.75rem);
  }

  .rejilla :global(.tarjeta__enlace) {
    background: var(--blanco);
  }

  @media (min-width: 640px) {
    .rejilla {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .rejilla {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  /* ── Puente a la otra marca ───────────────────────────── */
  .puente {
    padding-block: var(--seccion);
  }

  .puente__interior {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(1.75rem, 4vw, 3rem);
    border: 2px solid var(--gris-borde);
    border-radius: var(--radio-lg);
  }

  .puente__antetitulo {
    font-family: var(--condensada);
    font-size: var(--t-sm);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gris-suave);
    margin-bottom: 0.6rem;
  }

  .puente__interior h2 {
    font-size: var(--t-lg);
    color: var(--tinta);
  }

  .puente__texto {
    max-width: 48ch;
    margin-top: 0.75rem;
    font-size: var(--t-base);
    color: var(--gris-medio);
  }

  .puente__btn {
    flex-shrink: 0;
  }
</style>
