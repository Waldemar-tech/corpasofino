---
import { Image } from 'astro:assets';

import Base from '../layouts/Base.astro';
import Migas from '../components/Migas.astro';
import Distribuidores from '../components/Distribuidores.astro';

import mesaFamilia from '../assets/ilustraciones/mesa-familia.png';
import letDaleToque from '../assets/lettering/dale-el-toque-final.png';

import { SITE } from '../config/site.js';
import { migas, negocioLocal } from '../lib/schema.js';

const ruta = [
  { nombre: 'Inicio', href: '/' },
  { nombre: 'Nosotros', href: '/nosotros' },
];

const pilares = [
  {
    titulo: 'Producción local',
    texto: `Fabricamos en ${SITE.ciudad}, estado ${SITE.estado}. Lo que se consume en Venezuela se produce en Venezuela — con el empleo y la cadena de proveedores que eso implica.`,
  },
  {
    titulo: 'Receta constante',
    texto:
      'El mismo sabor en cada lote. Suena obvio, pero es la diferencia entre una marca en la que un comercio confía y una que le genera devoluciones.',
  },
  {
    titulo: 'Variedad completa',
    texto:
      'Siete referencias que cubren la mesa entera. Para el hogar significa menos vueltas; para el comercio, un solo proveedor en vez de cinco.',
  },
  {
    titulo: 'Practicidad',
    texto:
      'Presentaciones pensadas para el uso real: las que rinden en una cocina de casa y las que aguantan el ritmo de un negocio.',
  },
];
---

<Base
  titulo="Nosotros"
  descripcion={`${SITE.nombreLegal} es una empresa venezolana que elabora salsas y aderezos Foodie desde ${SITE.ciudad}, estado ${SITE.estado}. Conoce quiénes somos y cómo trabajamos.`}
  jsonLd={[migas(ruta), negocioLocal()]}
>
  <section class="intro">
    <div class="contenedor">
      <Migas ruta={ruta} />

      <div class="intro__grid">
        <div>
          <h1>Una empresa<br />venezolana, de verdad</h1>
        </div>
        <div class="intro__texto">
          <p>
            {SITE.nombreLegal} nació con una idea sencilla: que una salsa
            buena no tiene por qué venir de afuera. Desde {SITE.ciudad},
            en el estado {SITE.estado}, elaboramos la línea Foodie de
            salsas y aderezos para acompañar las comidas de todos los días.
          </p>
          <p>
            No fabricamos productos gourmet de vitrina. Fabricamos lo que
            se usa: el ketchup de la hamburguesa del sábado, la mayonesa
            de la ensalada del almuerzo, la salsa de ajo que se acaba
            primero en toda reunión.
          </p>
          <p class="intro__rif">RIF {SITE.rif}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="ilustracion">
    <div class="contenedor">
      <Image
        src={mesaFamilia}
        alt="Ilustración de personas compartiendo comida en la mesa"
        widths={[700, 1200, 1600]}
        sizes="(max-width: 900px) 96vw, 80vw"
        loading="lazy"
      />
    </div>
  </section>

  <section class="pilares">
    <div class="contenedor">
      <div class="pilares__cabeza">
        <h2>Cómo trabajamos</h2>
        <Image
          src={letDaleToque}
          alt=""
          widths={[240, 440]}
          sizes="220px"
          loading="lazy"
          class="lettering pilares__lettering"
        />
      </div>

      <ul class="pilares__lista">
        {
          pilares.map((p, i) => (
            <li class="pilar">
              <span class="pilar__num" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3>{p.titulo}</h3>
              <p>{p.texto}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Distribuidores />
</Base>

<style>
  .intro {
    padding-block: clamp(1.5rem, 3vw, 2.5rem) clamp(2.5rem, 5vw, 4rem);
  }

  .intro__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  .intro h1 {
    color: var(--verde-titulo);
  }

  .intro__texto p {
    font-size: var(--t-md);
    line-height: 1.7;
    color: var(--gris-medio);
  }

  .intro__texto p + p {
    margin-top: 1.25rem;
  }

  .intro__rif {
    font-family: var(--condensada);
    font-size: 1rem !important;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gris-suave) !important;
  }

  @media (max-width: 820px) {
    .intro__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }
  }

  .ilustracion :global(img) {
    width: 100%;
    max-width: 1100px;
    margin-inline: auto;
    height: auto;
  }

  .pilares {
    padding-block: var(--seccion);
  }

  .pilares__cabeza {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .pilares__cabeza h2 {
    color: var(--verde-titulo);
  }

  .pilares__lettering {
    width: clamp(150px, 20vw, 220px);
    height: auto;
  }

  .pilares__lista {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .pilar {
    padding-top: 1.25rem;
    border-top: 3px solid var(--verde);
  }

  .pilar__num {
    display: block;
    font-family: var(--display);
    font-size: 1.6rem;
    color: var(--ambar);
    line-height: 1;
    margin-bottom: 0.6rem;
  }

  .pilar h3 {
    font-family: var(--condensada);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--tinta);
  }

  .pilar p {
    margin-top: 0.6rem;
    font-size: var(--t-sm);
    line-height: 1.65;
    color: var(--gris-medio);
  }
</style>
