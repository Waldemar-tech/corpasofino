---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import type { GetStaticPaths } from 'astro';

import Base from '../../layouts/Base.astro';
import Icono from '../../components/Icono.astro';
import Migas from '../../components/Migas.astro';
import TarjetaReceta from '../../components/TarjetaReceta.astro';
import TarjetaProducto from '../../components/TarjetaProducto.astro';
import botella from '../../assets/placeholder/botella.png';

import { enlaceWhatsApp } from '../../lib/whatsapp.js';
import { producto as schemaProducto, migas } from '../../lib/schema.js';

export const getStaticPaths: GetStaticPaths = async () => {
  const productos = await getCollection('productos');
  return productos.map((entrada) => ({
    params: { id: entrada.id },
    props: { entrada },
  }));
};

const { entrada } = Astro.props;
const { data } = entrada;
const { Content } = await render(entrada);

// Venta cruzada: recetas que declaran usar este producto.
const recetas = (await getCollection('recetas'))
  .filter((r) => r.data.productos.includes(entrada.id))
  .sort((a, b) => a.data.orden - b.data.orden)
  .slice(0, 3);

// Otros productos, para que la ficha no sea un callejón sin salida.
const otros = (await getCollection('productos'))
  .filter((p) => p.id !== entrada.id)
  .sort((a, b) => a.data.orden - b.data.orden)
  .slice(0, 4);

const ruta = [
  { nombre: 'Inicio', href: '/' },
  { nombre: 'Productos', href: '/productos' },
  { nombre: data.nombre, href: `/productos/${entrada.id}` },
];

const wa = enlaceWhatsApp('general', data.nombre);
const imagen = data.imagen ?? botella;
const esPlaceholder = !data.imagen;
---

<Base
  titulo={`${data.nombre} Foodie`}
  descripcion={data.metaDescripcion ?? data.descripcionCorta}
  tipo="product"
  jsonLd={[
    schemaProducto(data, `/productos/${entrada.id}`),
    migas(ruta),
  ]}
>
  <div
    class="ficha"
    data-contenido-tipo="product"
    data-contenido-nombre={data.nombre}
    data-contenido-id={entrada.id}
  >
    <div class="contenedor">
      <Migas ruta={ruta} />

      <div class="ficha__grid">
        <div class:list={['ficha__medio', { 'es-placeholder': esPlaceholder }]}>
          <Image
            src={imagen}
            alt={data.imagenAlt ?? `Envase de ${data.nombre} Foodie`}
            widths={[420, 760, 1000]}
            sizes="(max-width: 900px) 90vw, 46vw"
            loading="eager"
            fetchpriority="high"
          />
          {
            esPlaceholder && (
              <span class="ficha__aviso">Fotografía pendiente</span>
            )
          }
        </div>

        <div class="ficha__info">
          <h1 class="ficha__titulo">{data.nombre}</h1>

          <p class="ficha__desc">
            {data.gancho && <em class="ficha__gancho">{data.gancho}</em>}
            {' '}{data.descripcionCorta}
          </p>

          {
            data.medidas.length > 0 && (
              <p class="ficha__medida">
                <span>Presentación:</span> {data.medidas.join(' · ')}
              </p>
            )
          }

          <div class="ficha__cuerpo">
            <Content />
          </div>

          <div class="ficha__acciones">
            <a
              class="btn btn--wa ficha__cta"
              href={wa}
              data-wa="general"
              data-wa-etiqueta={`Ficha ${data.nombre}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icono nombre="whatsapp" tamano={22} />
              Consultar disponibilidad
            </a>
            <a href="/#distribuidores" class="ficha__enlace-b2b">
              ¿Lo quieres para tu negocio? Precios por volumen
              <Icono nombre="flecha" tamano={16} />
            </a>
          </div>

          {
            (data.ingredientes || data.informacionNutricional) && (
              <div class="acordeon">
                {data.ingredientes && (
                  <details>
                    <summary>
                      Ingredientes
                      <span class="acordeon__signo" aria-hidden="true" />
                    </summary>
                    <div class="acordeon__cuerpo">
                      <p>{data.ingredientes}</p>
                    </div>
                  </details>
                )}
                {data.informacionNutricional && (
                  <details>
                    <summary>
                      Información nutricional
                      <span class="acordeon__signo" aria-hidden="true" />
                    </summary>
                    <div class="acordeon__cuerpo">
                      <p>{data.informacionNutricional}</p>
                    </div>
                  </details>
                )}
              </div>
            )
          }
        </div>
      </div>
    </div>
  </div>

  {
    recetas.length > 0 && (
      <section class="cruzada cruzada--recetas">
        <div class="contenedor">
          <h2 class="cruzada__titulo">Recetas con {data.nombre}</h2>
          <ul class="cruzada__lista">
            {recetas.map((receta) => (
              <li>
                <TarjetaReceta receta={receta} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="cruzada">
    <div class="contenedor">
      <h2 class="cruzada__titulo">Otros productos Foodie</h2>
      <ul class="cruzada__lista cruzada__lista--productos">
        {
          otros.map((p) => (
            <li>
              <TarjetaProducto producto={p} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .ficha {
    padding-block: clamp(1.5rem, 3vw, 2.5rem) var(--seccion);
  }

  .ficha__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  .ficha__medio {
    position: relative;
    aspect-ratio: 1;
    background: var(--gris-fondo);
    border-radius: var(--radio);
  }

  .ficha__medio :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: clamp(2rem, 5vw, 4rem);
    object-fit: contain;
  }

  .es-placeholder :global(img) {
    opacity: 0.5;
  }

  .ficha__aviso {
    position: absolute;
    top: 1rem;
    left: 1rem;
    padding: 0.25rem 0.75rem;
    font-family: var(--condensada);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--gris-medio);
    background: rgb(255 255 255 / 85%);
    border-radius: var(--radio-pill);
  }

  .ficha__titulo {
    color: var(--tinta);
  }

  .ficha__desc {
    margin-top: 1.25rem;
    font-size: var(--t-md);
    line-height: 1.65;
    color: var(--gris-fuerte);
  }

  .ficha__gancho {
    font-weight: 600;
    font-style: italic;
    color: var(--tinta);
  }

  .ficha__medida {
    margin-top: 1rem;
    font-family: var(--condensada);
    font-size: 1.05rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--gris-medio);
  }

  .ficha__medida span {
    font-weight: 700;
    color: var(--tinta);
  }

  .ficha__cuerpo {
    margin-top: 1.25rem;
    font-size: var(--t-base);
    line-height: 1.7;
    color: var(--gris-medio);
  }

  .ficha__cuerpo :global(p + p) {
    margin-top: 1rem;
  }

  .ficha__acciones {
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
  }

  .ficha__cta {
    font-size: var(--t-md);
  }

  .ficha__enlace-b2b {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1rem;
    font-family: var(--condensada);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--verde-titulo);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .ficha__enlace-b2b:hover {
    color: var(--tinta);
  }

  /* ── Acordeón ─────────────────────────────────────────── */
  .acordeon {
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .acordeon details {
    border-bottom: 1.5px solid var(--verde);
  }

  .acordeon summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 0;
    font-size: var(--t-md);
    cursor: pointer;
    list-style: none;
  }

  .acordeon summary::-webkit-details-marker {
    display: none;
  }

  .acordeon__signo {
    position: relative;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .acordeon__signo::before,
  .acordeon__signo::after {
    content: '';
    position: absolute;
    background: var(--tinta);
    transition: transform var(--transicion);
  }

  .acordeon__signo::before {
    inset: 7px 0;
    height: 2px;
  }

  .acordeon__signo::after {
    inset: 0 7px;
    width: 2px;
  }

  .acordeon details[open] .acordeon__signo::after {
    transform: scaleY(0);
  }

  .acordeon__cuerpo {
    padding-bottom: 1.25rem;
    font-size: var(--t-sm);
    line-height: 1.7;
    color: var(--gris-medio);
  }

  @media (max-width: 900px) {
    .ficha__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ── Bloques de venta cruzada ─────────────────────────── */
  .cruzada {
    padding-block: 0 var(--seccion);
  }

  .cruzada--recetas {
    background: var(--gris-fondo);
    padding-block: var(--seccion);
    margin-bottom: var(--seccion);
  }

  .cruzada__titulo {
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
    color: var(--verde-titulo);
    font-size: var(--t-lg);
  }

  .cruzada__lista {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: clamp(1rem, 2vw, 1.75rem);
  }

  .cruzada__lista--productos {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
  }
</style>
