---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import type { GetStaticPaths } from 'astro';

import Base from '../../layouts/Base.astro';
import Migas from '../../components/Migas.astro';
import TarjetaReceta from '../../components/TarjetaReceta.astro';
import TarjetaProducto from '../../components/TarjetaProducto.astro';
import ilusSandwich from '../../assets/ilustraciones/sandwich-ensalada.png';
import letPonleToque from '../../assets/lettering/ponle-el-toque-foodie.png';

import { receta as schemaReceta, migas } from '../../lib/schema.js';

export const getStaticPaths: GetStaticPaths = async () => {
  const recetas = await getCollection('recetas');
  return recetas.map((entrada) => ({
    params: { id: entrada.id },
    props: { entrada },
  }));
};

const { entrada } = Astro.props;
const { data } = entrada;
const { Content } = await render(entrada);

const todosProductos = await getCollection('productos');
const productosUsados = todosProductos
  .filter((p) => data.productos.includes(p.id))
  .sort((a, b) => a.data.orden - b.data.orden);

const otras = (await getCollection('recetas'))
  .filter((r) => r.id !== entrada.id)
  .sort((a, b) => a.data.orden - b.data.orden)
  .slice(0, 3);

const total = data.tiempoPreparacion + data.tiempoCoccion;

const ruta = [
  { nombre: 'Inicio', href: '/' },
  { nombre: 'Recetas', href: '/recetas' },
  { nombre: data.titulo, href: `/recetas/${entrada.id}` },
];
---

<Base
  titulo={data.titulo}
  descripcion={data.metaDescripcion ?? data.descripcion}
  tipo="article"
  jsonLd={[schemaReceta(data, `/recetas/${entrada.id}`), migas(ruta)]}
>
  <article
    class="receta"
    data-contenido-tipo="recipe"
    data-contenido-nombre={data.titulo}
    data-contenido-id={entrada.id}
  >
    <div class="contenedor">
      <Migas ruta={ruta} />

      <header class="receta__cabeza">
        <div class="receta__medio">
          {
            data.imagen ? (
              <Image
                src={data.imagen}
                alt={data.imagenAlt ?? data.titulo}
                widths={[520, 900, 1200]}
                sizes="(max-width: 900px) 92vw, 46vw"
                loading="eager"
                fetchpriority="high"
              />
            ) : (
              <div class="receta__vacio">
                <span>Fotografía pendiente</span>
              </div>
            )
          }
        </div>

        <div class="receta__intro">
          <h1>{data.titulo}</h1>
          <p class="receta__desc">{data.descripcion}</p>

          <dl class="datos">
            <div class="datos__item">
              <dt>Preparación</dt>
              <dd>{data.tiempoPreparacion} min</dd>
            </div>
            {
              data.tiempoCoccion > 0 && (
                <div class="datos__item">
                  <dt>Cocción</dt>
                  <dd>{data.tiempoCoccion} min</dd>
                </div>
              )
            }
            <div class="datos__item">
              <dt>Total</dt>
              <dd>{total} min</dd>
            </div>
            <div class="datos__item">
              <dt>Raciones</dt>
              <dd>{data.raciones}</dd>
            </div>
            <div class="datos__item">
              <dt>Dificultad</dt>
              <dd>{data.dificultad}</dd>
            </div>
          </dl>
        </div>
      </header>

      <div class="receta__cuerpo">
        <section class="ingredientes" aria-labelledby="t-ingredientes">
          <h2 id="t-ingredientes">Ingredientes</h2>
          <ul>
            {
              data.ingredientes.map((ing) => (
                <li>
                  {ing.cantidad && <strong>{ing.cantidad}</strong>} {ing.item}
                </li>
              ))
            }
          </ul>
        </section>

        <section class="pasos" aria-labelledby="t-pasos">
          <h2 id="t-pasos">Preparación</h2>
          <ol>
            {
              data.pasos.map((paso, i) => (
                <li>
                  <span class="pasos__num" aria-hidden="true">{i + 1}.</span>
                  <p>{paso}</p>
                </li>
              ))
            }
          </ol>

          <div class="nota">
            <Content />
          </div>
        </section>
      </div>

      <div class="adorno" aria-hidden="true">
        <Image
          src={ilusSandwich}
          alt=""
          widths={[420, 760]}
          sizes="(max-width: 720px) 80vw, 420px"
          loading="lazy"
        />
      </div>
    </div>
  </article>

  {
    productosUsados.length > 0 && (
      <section class="usa">
        <div class="contenedor">
          <div class="usa__cabeza">
            <h2>Con productos Foodie</h2>
            <Image
              src={letPonleToque}
              alt=""
              widths={[220, 420]}
              sizes="200px"
              loading="lazy"
              class="lettering usa__lettering"
            />
          </div>
          <ul class="usa__lista">
            {productosUsados.map((p) => (
              <li>
                <TarjetaProducto producto={p} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="mas">
    <div class="contenedor">
      <h2 class="mas__titulo">Más recetas</h2>
      <ul class="mas__lista">
        {
          otras.map((r) => (
            <li>
              <TarjetaReceta receta={r} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .receta {
    padding-block: clamp(1.5rem, 3vw, 2.5rem) var(--seccion);
  }

  .receta__cabeza {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  .receta__medio :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radio-lg);
  }

  .receta__vacio {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    background: var(--gris-fondo);
    border-radius: var(--radio-lg);
  }

  .receta__vacio span {
    font-family: var(--condensada);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gris-suave);
  }

  .receta__intro h1 {
    color: var(--tinta);
  }

  .receta__desc {
    margin-top: 1.25rem;
    font-size: var(--t-md);
    line-height: 1.65;
    color: var(--gris-medio);
  }

  /* ── Datos de la receta ───────────────────────────────── */
  .datos {
    display: flex;
    flex-wrap: wrap;
    gap: 1.75rem 2.5rem;
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    padding-top: 1.5rem;
    border-top: 1.5px solid var(--verde);
  }

  .datos__item dt {
    font-family: var(--condensada);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gris-suave);
  }

  .datos__item dd {
    margin-top: 0.15rem;
    font-family: var(--condensada);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--tinta);
  }

  /* ── Cuerpo ───────────────────────────────────────────── */
  .receta__cuerpo {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .receta__cuerpo h2 {
    font-size: var(--t-lg);
    color: var(--tinta);
    margin-bottom: 1.5rem;
  }

  .ingredientes ul {
    display: grid;
    gap: 0.75rem;
  }

  .ingredientes li {
    padding-bottom: 0.75rem;
    font-size: var(--t-base);
    color: var(--gris-medio);
    border-bottom: 1px solid var(--gris-borde);
  }

  .ingredientes strong {
    font-weight: 700;
    color: var(--tinta);
  }

  .pasos ol {
    display: grid;
    gap: 1.5rem;
    counter-reset: paso;
  }

  .pasos li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.9rem;
    align-items: baseline;
  }

  .pasos__num {
    font-family: var(--display);
    font-size: 1.4rem;
    color: var(--verde);
  }

  .pasos p {
    font-size: var(--t-base);
    line-height: 1.7;
    color: var(--gris-fuerte);
  }

  .nota {
    margin-top: 2.5rem;
    padding: 1.25rem 1.5rem;
    font-size: var(--t-sm);
    line-height: 1.7;
    color: var(--gris-medio);
    background: var(--gris-fondo);
    border-left: 4px solid var(--ambar);
    border-radius: 0 var(--radio) var(--radio) 0;
  }

  .adorno {
    display: flex;
    justify-content: center;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .adorno :global(img) {
    width: clamp(240px, 40vw, 420px);
    height: auto;
  }

  @media (max-width: 900px) {
    .receta__cabeza,
    .receta__cuerpo {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ── Productos usados ─────────────────────────────────── */
  .usa {
    background: var(--gris-fondo);
    padding-block: var(--seccion);
  }

  .usa__cabeza {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .usa__cabeza h2 {
    font-size: var(--t-lg);
    color: var(--verde-titulo);
  }

  .usa__lettering {
    width: clamp(140px, 18vw, 200px);
    height: auto;
  }

  .usa__lista,
  .mas__lista {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    gap: clamp(1rem, 2vw, 1.75rem);
  }

  .mas {
    padding-block: var(--seccion);
  }

  .mas__titulo {
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
    font-size: var(--t-lg);
    color: var(--verde-titulo);
  }

  .mas__lista {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
  }
</style>
