---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

import Base from '../../layouts/Base.astro';
import TarjetaReceta from '../../components/TarjetaReceta.astro';
import Migas from '../../components/Migas.astro';

import letHero from '../../assets/lettering/recetas-para-disfrutarlo-mejor.png';
import letInspirate from '../../assets/lettering/inspirate-y-cocina.png';
import ilusHamburguesa from '../../assets/ilustraciones/hamburguesa-papas.png';
import ilusMujer from '../../assets/ilustraciones/mujer-ensalada.png';

import { migas } from '../../lib/schema.js';

const recetas = (await getCollection('recetas')).sort(
  (a, b) => a.data.orden - b.data.orden
);

const ruta = [
  { nombre: 'Inicio', href: '/' },
  { nombre: 'Recetas', href: '/recetas' },
];

// El listado de recetas de una marca de alimentos es, en la práctica,
// su motor de SEO: cada receta es una consulta que la gente busca en
// Google. Por eso van todas indexadas y con schema Recipe.
const listaSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: recetas.map((r, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: r.data.titulo,
    url: new URL(`/recetas/${r.id}`, Astro.site).href,
  })),
};
---

<Base
  titulo="Recetas"
  descripcion="Recetas fáciles con salsas Foodie: hamburguesas, papas crispy, pollo gratinado, ensaladas y más. Paso a paso, con tiempos reales y dificultad."
  jsonLd={[migas(ruta), listaSchema]}
>
  <section class="portada">
    <div class="contenedor">
      <Migas ruta={ruta} />

      <div class="portada__hero">
        <h1 class="solo-lectores">Recetas Foodie</h1>
        <Image
          src={letHero}
          alt="Recetas para disfrutarlo mejor"
          widths={[520, 900]}
          sizes="(max-width: 720px) 88vw, 620px"
          loading="eager"
          fetchpriority="high"
          class="lettering portada__lettering"
        />
        <p class="portada__intro">
          Platos que se resuelven en la cocina de verdad, con lo que hay
          en la nevera y una salsa Foodie a la mano.
        </p>
      </div>
    </div>
  </section>

  <section class="listado">
    <div class="contenedor">
      <Image
        src={letInspirate}
        alt=""
        widths={[240, 440]}
        sizes="(max-width: 720px) 48vw, 220px"
        loading="lazy"
        class="lettering listado__nota"
      />

      <ul class="rejilla">
        {
          recetas.map((receta, i) => (
            <li>
              <TarjetaReceta receta={receta} prioridad={i < 2} />
            </li>
          ))
        }
      </ul>

      <div class="adornos" aria-hidden="true">
        <Image
          src={ilusHamburguesa}
          alt=""
          widths={[280, 520]}
          sizes="240px"
          loading="lazy"
        />
        <Image
          src={ilusMujer}
          alt=""
          widths={[320, 600]}
          sizes="300px"
          loading="lazy"
        />
      </div>
    </div>
  </section>
</Base>

<style>
  .portada {
    padding-block: clamp(1.5rem, 3vw, 2.5rem) clamp(1.5rem, 3vw, 2.5rem);
    background: var(--gris-fondo);
  }

  .portada__hero {
    display: grid;
    justify-items: center;
    text-align: center;
    padding-block: clamp(1.5rem, 4vw, 3.5rem);
  }

  .portada__lettering {
    width: clamp(280px, 52vw, 620px);
    height: auto;
  }

  .portada__intro {
    max-width: 52ch;
    margin-top: 1.5rem;
    font-size: var(--t-md);
    color: var(--gris-medio);
  }

  .listado {
    position: relative;
    padding-block: var(--seccion);
  }

  .listado__nota {
    width: clamp(150px, 20vw, 220px);
    height: auto;
    margin: 0 0 1.5rem auto;
  }

  .rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }

  .adornos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-around;
    gap: 2rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    opacity: 0.85;
  }

  .adornos :global(img) {
    width: clamp(180px, 26vw, 300px);
    height: auto;
  }

  @media (max-width: 640px) {
    .adornos :global(img:last-child) {
      display: none;
    }
  }
</style>
